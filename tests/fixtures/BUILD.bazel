# Where run_sync_pipeline.py finds the embedding model, for a run whose
# servers' syncs embed (`tng_fuzz_test`). The fixture's own sync embeds
# nothing and is given none.
_TNG_EMBED_MODEL_ENV = {
    "INGESTED_TNG_EMBED_MODEL": "$(rootpath //third-party/embedding_models:embeddinggemma)",
}

# py_test that drives the same `run_sync_pipeline.py` invocation as
# :ingested_tng. Three reasons it exists:
#
#   1. Plain `bazelisk test //...` exercises the end-to-end pipeline
#      (the genrule isn't a test, so it didn't before).
#   2. `bazelisk coverage` collects coverage on `datalib_dag` /
#      `datalib_step` and `signal_make_fixture` through this test's
#      `data` deps —
#      rules_rust's coverage transition propagates through `data`,
#      not just `deps`. See //docs/dev/coverage.md for the full workflow.
#   3. The test runs the pipeline THREE times against one data root
#      (fresh / steady-state / `--reset` then sync) to exercise
#      signal's `ingested_backups` Blake3 resume cursor and the
#      reset-clears-cursor path.
py_test(
    name = "ingested_tng_test",
    srcs = ["ingested_tng_test.py"],
    args = [
        "$(rootpath run_sync_pipeline.py)",
        "$(rootpath //datalib/backend/dag:datalib_dag_bin)",
        "$(rootpath //datalib/backend/datalib_step:datalib_step)",
        "$(rootpath //datalib/backend/signal-backup:signal_make_fixture)",
        "$(rootpath //datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture)",
        # Bazel-built sqlite3 shell linked against the doltlite
        # amalgamation, so the test can open the stores the pipeline
        # just wrote. Stock sqlite3 cannot: doltlite's on-disk format
        # is not sqlite-file-compatible.
        "$(rootpath //third-party/doltlite:doltlite)",
        "2369-04-15T00:00:00+00:00",
    ] + _TNG_FIXTURE_ARGS,
    data = [
        "make_beeper_texts.py",
        "run_sync_pipeline.py",
        "sync_drivers.py",
        ":source_json",
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        "//datalib/backend/signal-backup:signal_make_fixture",
        "//datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture",
        "//datalib/backend/etl/providers/yolink:yolink_make_fixture",
        "//third-party/doltlite:doltlite",
    ],
)

# The provider contract (one_mode.md, "Layer 2"): for every render
# provider and every table of its raw store, mutate the table, render
# incrementally and cold, and compare. Same pipeline, same args and
# data as `ingested_tng_test`; a separate target so its runtime — two
# renders per mutation, ~500 mutations — stays its own. Sharded by
# source: each shard reruns the pipeline (seconds) and sweeps a quarter
# of the sources, dealt out by table count so the shards finish together.
py_test(
    name = "render_contract_test",
    shard_count = 4,
    srcs = ["render_contract_test.py"],
    args = [
        "$(rootpath run_sync_pipeline.py)",
        "$(rootpath //datalib/backend/dag:datalib_dag_bin)",
        "$(rootpath //datalib/backend/datalib_step:datalib_step)",
        "$(rootpath //datalib/backend/signal-backup:signal_make_fixture)",
        "$(rootpath //datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture)",
        # Bazel-built sqlite3 shell linked against the doltlite
        # amalgamation, so the test can open the stores the pipeline
        # just wrote. Stock sqlite3 cannot: doltlite's on-disk format
        # is not sqlite-file-compatible.
        "$(rootpath //third-party/doltlite:doltlite)",
        "2369-04-15T00:00:00+00:00",
    ] + _TNG_FIXTURE_ARGS,
    data = [
        "make_beeper_texts.py",
        "run_sync_pipeline.py",
        "sync_drivers.py",
        ":source_json",
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        "//datalib/backend/signal-backup:signal_make_fixture",
        "//datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture",
        "//datalib/backend/etl/providers/yolink:yolink_make_fixture",
        "//third-party/doltlite:doltlite",
    ],
    size = "large",
)

# The search index over the TNG fixture, built as a sync builds it:
# `unified_grid_and_search_index`'s keyword pass (the real `datalib-step`) over `:ingested_tng`'s
# rendered tree, every document cut into chunks as `embed` cuts them, then
# every chunk embedded into an inference cache. Three actions, because the
# first's inputs change on every run (wall-clock stamps in the render
# stores, tar_rendered.py) and the second is the slow one: it reads only
# the prompts and links only the embedder, so Bazel embeds again only when
# a prompt, the embedder or the model changes. The third writes the
# vectors beside the chunks the first filed.
genrule(
    name = "ingested_tng_search_index",
    srcs = [
        "ingested/rendered.tar",
        "ingested/backend_index.sqlite",
        "//datalib/backend/datalib_step:datalib_step",
        "//datalib/backend/search_index:search_prompts",
        "//third-party/embedding_models:embeddinggemma",
    ],
    outs = [
        "ingested/search_index.sqlite",
        "ingested/search_prompts.tsv",
        "ingested/search_chunks.sqlite",
    ],
    tools = [
        "build_search_index.py",
        "quiet.sh",
    ],
    cmd = " ".join([
        "$(execpath quiet.sh) $(RULEDIR)/search_index.log",
        "python3 $(execpath build_search_index.py)",
        "$(execpath //datalib/backend/datalib_step:datalib_step)",
        "$(execpath //datalib/backend/search_index:search_prompts)",
        "$(execpath //third-party/embedding_models:embeddinggemma)",
        "$(execpath ingested/rendered.tar)",
        "$(execpath ingested/backend_index.sqlite)",
        "$(execpath ingested/search_index.sqlite)",
        "$(execpath ingested/search_prompts.tsv)",
        "$(execpath ingested/search_chunks.sqlite)",
    ]),
    visibility = ["//visibility:public"],
)

genrule(
    name = "ingested_tng_vectors",
    srcs = [
        "ingested/search_prompts.tsv",
        "//datalib/backend/embedder:embed_prompts",
        "//third-party/embedding_models:embeddinggemma",
    ],
    outs = ["ingested/vectors.tsv"],
    tools = ["quiet.sh"],
    cmd = " ".join([
        "$(execpath quiet.sh) $(RULEDIR)/vectors.log",
        "$(execpath //datalib/backend/embedder:embed_prompts)",
        "$(execpath ingested/search_prompts.tsv)",
        "$(execpath //third-party/embedding_models:embeddinggemma)",
        "$(execpath ingested/vectors.tsv)",
    ]),
    # Cached remotely, never run there: its inputs are ~300 MB, and
    # remote execution's transfer budget is better spent elsewhere.
    tags = ["no-remote-exec"],
    visibility = ["//visibility:public"],
)

# The vectors as the search index reads them. Its own action, and a cheap
# one, because it links the search index, which changes far more often
# than the embedder.
genrule(
    name = "ingested_tng_inference_cache",
    srcs = [
        "ingested/vectors.tsv",
        "ingested/search_chunks.sqlite",
        "//datalib/backend/search_index:cache_vectors",
    ],
    outs = ["ingested/inference_cache.sqlite"],
    tools = ["quiet.sh"],
    cmd = " ".join([
        "$(execpath quiet.sh) $(RULEDIR)/inference_cache.log",
        "$(execpath //datalib/backend/search_index:cache_vectors)",
        "$(execpath ingested/vectors.tsv)",
        "$(execpath ingested/search_chunks.sqlite)",
        "$(execpath ingested/inference_cache.sqlite)",
    ]),
    visibility = ["//visibility:public"],
)

# The run store, end to end, read by an engine that is not ours.
#
# Runs the real runner and opens `system/runs/runs.sqlite` with Python's
# stdlib sqlite3 — a separate engine in a separate process that knows
# nothing about doltlite. Deliberately NOT folded into :ingested_tng:
# the store carries wall-clock timestamps, and that fixture is the
# tree's deterministic, cacheable one.
py_test(
    name = "runs_store_e2e_test",
    size = "small",
    srcs = ["runs_store_e2e_test.py"],
    args = ["$(rootpath //datalib/backend/dag:datalib_dag_bin)"],
    data = ["//datalib/backend/dag:datalib_dag_bin"],
)

# `GET /metrics` read by Prometheus's own parser: a step run by the real
# `datalib-dag`, the root served by the real `datalib-http`, the scrape
# parsed by `prometheus_client`. The one Python dependency any test here
# takes, and only because the parser is the claim.
py_test(
    name = "metrics_export_e2e_test",
    size = "small",
    srcs = ["metrics_export_e2e_test.py"],
    args = [
        "$(rootpath //datalib/backend/dag:datalib_dag_bin)",
        "$(rootpath //datalib/backend/http:datalib_http_bin)",
    ],
    data = [
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/http:datalib_http_bin",
    ],
    deps = [requirement("prometheus-client")],
)

# The sync state machine under a storm (docs/dev/plans/http_driven_e2e.md
# § 2): seeded clicks on the server's buttons and SIGKILLs of its steps,
# then a full sync compared with a reset and a sync from nothing. One
# case per shard; `TNG_FUZZ_SEED=<n>` replays one. `manual` until the
# Manage screen can start and stop single steps: its events join the
# storm then, and the target joins CI.
py_test(
    name = "tng_fuzz_test",
    size = "large",
    tags = ["manual"],
    srcs = ["tng_fuzz_test.py"],
    args = [
        "$(rootpath //third-party/doltlite:doltlite)",
        "$(rootpath //datalib/backend/dag:datalib_dag_bin)",
        "$(rootpath //datalib/backend/datalib_step:datalib_step)",
        "$(rootpath //datalib/backend/signal-backup:signal_make_fixture)",
        "$(rootpath //datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture)",
        "2369-04-15T00:00:00+00:00",
        # The data root: each case takes a temporary one.
        "-",
    ] + _TNG_FIXTURE_ARGS + [
        "$(rootpath //datalib/backend/http:datalib_http_bin)",
    ],
    data = [
        "make_beeper_texts.py",
        "run_sync_pipeline.py",
        "sync_drivers.py",
        ":source_json",
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        "//datalib/backend/http:datalib_http_bin",
        "//datalib/backend/signal-backup:signal_make_fixture",
        "//datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture",
        "//datalib/backend/etl/providers/yolink:yolink_make_fixture",
        "//third-party/doltlite:doltlite",
        "//third-party/embedding_models:embeddinggemma",
    ],
    env = _TNG_EMBED_MODEL_ENV,
    shard_count = 4,
)

# `manual` keeps `tng_fuzz_test` out of `bazel test //...`; this keeps
# it built there, so it cannot rot unnoticed (scripts/lint_repo.py).
build_test(
    name = "manual_targets_build",
    targets = [":tng_fuzz_test"],
)
