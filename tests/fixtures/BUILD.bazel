load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Surface this BUILD file as a data target so //tools:version_pins_test
# can read the QMD_VERSION constant out of it at test time.
# `make_lightroom_catalog.py` is exported so the lightroom provider's
# `:tng_catalog` genrule can reach it across the package boundary. It
# lives here rather than beside that provider because `tests/fixtures`
# is one of the three PYTHON_LINT_ROOTS (see scripts/lint_repo.py) —
# and because AGENTS.md scopes Python in this repo to exactly this:
# fixture / test-pipeline tooling.
exports_files([
    "BUILD.bazel",
    "make_lightroom_catalog.py",
])

# This package's contribution to `//:python_sources` — glob can't cross a
# package boundary, so the root filegroup can't reach these itself. See
# the comment on `//:python_sources` for how omissions get caught.
filegroup(
    name = "python_sources",
    srcs = glob(["*.py"], allow_empty = False),
    visibility = ["//visibility:public"],
)

# qmd's three GGUF models, pinned in MODULE.bazel and fetched by bazel
# rather than downloaded by qmd at run time. Only the materialize path
# takes all three: `:ingested_tng_qmd` embeds and nothing else, so it
# names the embedding model alone rather than dragging 1.8 GB of inputs
# it never opens through every action key.
filegroup(
    name = "qmd_models",
    srcs = [
        "@qmd_model_embeddinggemma//file",
        "@qmd_model_query_expansion//file",
        "@qmd_model_reranker//file",
    ],
    visibility = ["//visibility:public"],
)

# Materialize a datalib data root from :ingested_tng + :ingested_tng_qmd
# into a caller-provided directory. Used by both `//datalib:dev_tng`
# (interactive eyeballing) and the UI e2e test (fixture setup) so the two
# paths can't drift apart.
sh_binary(
    name = "materialize_tng_root",
    srcs = ["materialize_tng_root.sh"],
    data = [
        ":ingested_tng",
        ":ingested_tng_qmd",
        # The models the materialized root's `unified_index/qmd/models`
        # points at. Before this they came from the developer's
        # `~/.cache/qmd/models`, and the script refused to run when that
        # was empty — which made "have you run qmd once?" a prerequisite
        # for `bazelisk run //datalib:dev_tng` and for the e2e suite.
        ":qmd_models",
        # TNG-themed scan tree dropped into the root as `fsindex_scan/` — a
        # directory the `fsindex` (Unison-style) scanner can index. It's not
        # rendered (fsindex is extract-only), so it just sits in the root.
        "//datalib/backend/etl/providers/fsindex:tng_fixture",
        # The generated config declares the `unified_index` applet, and
        # the gateway spawns it by the command written there. Naming the
        # binary's runfiles path keeps that resolvable without a
        # `binary_dir` or a PATH assumption.
        "//datalib/backend/applets:datalib_applet",
    ],
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Cacheable, ingested-fixture artifact.
#
# `bazelisk build //tests/fixtures:ingested_tng` runs the full
# pipeline (ingest -> render) against the checked-in TNG-themed source
# JSON and emits two outputs:
#
#   * backend_index.doltlite_db -- the doltlite (SQLite-compatible) file the backend reads.
#   * qmd.tar   -- the rendered conversation markdown tree.

filegroup(
    name = "source_json",
    srcs = glob([
        "github_api/**/*.jsonl",
        "gitlab_api/**/*.jsonl",
        "notion_web/**/*.jsonl",
    ]) + [
        # Provider fixtures moved into their respective Rust crates so
        # the sample data is co-located with the code under test.
        "//datalib/backend/etl/providers/slack:tng_fixture",
        "//datalib/backend/etl/providers/chatgpt:tng_fixture",
        "//datalib/backend/etl/providers/claude:tng_fixture",
        "//datalib/backend/etl/providers/beeper:tng_fixture",
        "//datalib/backend/etl/providers/contacts:tng_fixture",
        "//datalib/backend/etl/providers/email:tng_fixture",
        "//datalib/backend/etl/providers/signal:tng_fixture",
        "//datalib/backend/etl/providers/whatsapp:tng_fixture",
        "//datalib/backend/etl/providers/google_takeout:tng_fixture",
        "//datalib/backend/etl/providers/linkedin:tng_fixture",
        "//datalib/backend/etl/providers/sms_backup_restore:tng_fixture",
        "//datalib/backend/etl/providers/yolink:tng_fixture",
        "//datalib/backend/etl/providers/pdf:pdf_fixture",
    ],
    visibility = ["//visibility:public"],
)

# Cacheable, deterministic ingest of the TNG fixtures via the DAG
# runner (//datalib/backend/dag:datalib_dag_bin driving
# //datalib/backend/datalib_step:datalib_step). The pipeline runs
# every source's download+render step pair over the checked-in
# fixtures and the index fan-in loads the resulting sidecars into
# `backend_index.doltlite_db` (the doltlite chunk store is linked
# statically via `//third-party/doltlite:sqlite3`, so no host `dolt`
# install is required). This rule then tars the rendered_md tree into
# qmd.tar.
# Tar packaging is *not* the pipeline binary's concern — it operates
# at the layer of DB + qmd files.
genrule(
    name = "ingested_tng",
    srcs = [":source_json"],
    outs = [
        "ingested/backend_index.doltlite_db",
        "ingested/qmd.tar",
    ],
    tools = [
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        # CLI that converts the signal TNG JSON spec into an encrypted
        # snapshot dir on the fly. Lives in the signal-backup library
        # crate; see that crate's BUILD.bazel.
        "//datalib/backend/signal-backup:signal_make_fixture",
        # Same idea for WhatsApp: spec → encrypted msgstore.db.crypt15 +
        # plaintext Media/. Root key defaults to 64 zeros, like the
        # signal fixture AEP.
        "//datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture",
        # Spec → seeded doltlite raw store. YoLink has no playback path
        # (its downloader shells out to `curl`), so the fixture pipeline
        # emits no download step and renders over the store this binary
        # writes.
        "//datalib/backend/etl/providers/yolink:yolink_make_fixture",
        "run_sync_pipeline.py",
        "tar_qmd.py",
    ],
    cmd = " && ".join([
        " ".join([
            "python3 $(execpath run_sync_pipeline.py)",
            "$(execpath //datalib/backend/dag:datalib_dag_bin)",
            "$(execpath //datalib/backend/datalib_step:datalib_step)",
            "$(execpath //datalib/backend/signal-backup:signal_make_fixture)",
            "$(execpath //datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture)",
            "'2369-04-15T00:00:00+00:00'",
            "$(RULEDIR)/sync_workspace",
            "datalib/backend/etl/providers/claude/tests/fixtures/claude_export",
            "datalib/backend/etl/providers/chatgpt/tests/fixtures/chatgpt_api",
            "datalib/backend/etl/providers/slack/tests/fixtures/slack_api",
            "tests/fixtures/github_api",
            "tests/fixtures/gitlab_api",
            "tests/fixtures/notion_web",
            # Beeper is different — the fixture is SQL + media, not
            # an HTTP capture tree. run_sync_pipeline.py
            # materializes a BeeperTexts-shaped dir from it on the
            # fly.
            "datalib/backend/etl/providers/beeper/tests/fixtures/beeper_tng",
            # Contacts (carddav) is translate-only in the fixture
            # pipeline: vCard files on disk feed the translate path
            # directly, no synth/extract for these. The directory
            # structure is `carddav_tng/<addressbook>/*.vcf`.
            "datalib/backend/etl/providers/contacts/tests/fixtures/carddav_tng",
            # Signal is similar to beeper — the fixture is a JSON
            # spec; run_sync_pipeline.py runs signal_make_fixture on
            # it to produce the encrypted snapshot dir before invoking
            # extract.
            "datalib/backend/etl/providers/signal/tests/fixtures/signal_tng/tng.json",
            # WhatsApp: same shape as signal.
            "datalib/backend/etl/providers/whatsapp/tests/fixtures/whatsapp_tng/tng.json",
            # Email: Google Takeout mbox file. Drives the email
            # extract path (mbox → raw doltlite → translate → render).
            "datalib/backend/etl/providers/email/tests/fixtures/mbox/star_trek.mbox",
            # Google Takeout root. Google Chat feed renders; the rest land
            # in the raw store.
            "datalib/backend/etl/providers/google_takeout/tests/fixtures/Takeout",
            # LinkedIn export dir (Connections + messages + Skills). The
            # message feeds + connections render; fetch_photos is on, so
            # the synth phase writes photo playback fixtures.
            "datalib/backend/etl/providers/linkedin/tests/fixtures/linkedin_tng",
            # "SMS Backup & Restore" export dir (sms + calls XML with
            # inline base64 image/audio attachments). Texts + calls
            # render as one chat per phone number.
            "datalib/backend/etl/providers/sms_backup_restore/tests/fixtures/sms_backup_restore_tng",
            # YoLink (args 21-22, appended — see run_sync_pipeline.py's
            # docstring for why these two aren't grouped with the rest).
            "$(execpath //datalib/backend/etl/providers/yolink:yolink_make_fixture)",
            "datalib/backend/etl/providers/yolink/tests/fixtures/yolink_tng/tng.json",
            # PDF corpus (arg 23, appended for the same reason as 21-22).
            "datalib/backend/etl/providers/pdf/tests/fixtures/pdf_tng",
        ]),
        # Copy the doltlite (SQLite-compatible) file out of the workspace.
        # It lives under the `unified_index/` tree the index steps own
        # (see core::layout).
        "cp $(RULEDIR)/sync_workspace/unified_index/grid/db.doltlite_db $(execpath ingested/backend_index.doltlite_db)",
        # Tar the rendered_md tree hermetically into qmd.tar.
        " ".join([
            "python3 $(execpath tar_qmd.py)",
            "$(RULEDIR)/sync_workspace",
            "$(execpath ingested/qmd.tar)",
        ]),
    ]),
    visibility = ["//visibility:public"],
)

# py_test that drives the same `run_sync_pipeline.py` invocation as
# :ingested_tng. Three reasons it exists:
#
#   1. Plain `bazelisk test //...` exercises the end-to-end pipeline
#      (the genrule isn't a test, so it didn't before).
#   2. `bazelisk coverage` collects coverage on `datalib_dag` /
#      `datalib_step` and `signal_make_fixture` through this test's
#      `data` deps —
#      rules_rust's coverage transition propagates through `data`,
#      not just `deps`. See //docs/dev/coverage.md for the full workflow.
#   3. The test runs the pipeline THREE times against one data root
#      (fresh / steady-state / --reset-and-redownload) to exercise
#      signal's `ingested_backups` Blake3 resume cursor and the
#      reset-clears-cursor path.
py_test(
    name = "ingested_tng_test",
    srcs = ["ingested_tng_test.py"],
    args = [
        "$(rootpath run_sync_pipeline.py)",
        "$(rootpath //datalib/backend/dag:datalib_dag_bin)",
        "$(rootpath //datalib/backend/datalib_step:datalib_step)",
        "$(rootpath //datalib/backend/signal-backup:signal_make_fixture)",
        "$(rootpath //datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture)",
        # Bazel-built sqlite3 shell linked against the doltlite
        # amalgamation, so the test can open the stores the pipeline
        # just wrote. Stock sqlite3 cannot: doltlite's on-disk format
        # is not sqlite-file-compatible.
        "$(rootpath //third-party/doltlite:doltlite)",
        "2369-04-15T00:00:00+00:00",
        # FIXME: the lists below is a mishmash of paths.  We should standardize, likely inside the provider-specific directories.
        "datalib/backend/etl/providers/claude/tests/fixtures/claude_export",
        "datalib/backend/etl/providers/chatgpt/tests/fixtures/chatgpt_api",
        "datalib/backend/etl/providers/slack/tests/fixtures/slack_api",
        # FIXME: move these into their provider specific directories.
        "tests/fixtures/github_api",
        "tests/fixtures/gitlab_api",
        "tests/fixtures/notion_web",
        "datalib/backend/etl/providers/beeper/tests/fixtures/beeper_tng",
        "datalib/backend/etl/providers/contacts/tests/fixtures/carddav_tng",
        "datalib/backend/etl/providers/signal/tests/fixtures/signal_tng/tng.json",
        "datalib/backend/etl/providers/whatsapp/tests/fixtures/whatsapp_tng/tng.json",
        "datalib/backend/etl/providers/email/tests/fixtures/mbox/star_trek.mbox",
        "datalib/backend/etl/providers/google_takeout/tests/fixtures/Takeout",
        "datalib/backend/etl/providers/linkedin/tests/fixtures/linkedin_tng",
        "datalib/backend/etl/providers/sms_backup_restore/tests/fixtures/sms_backup_restore_tng",
        # YoLink (args 21-22, appended — see run_sync_pipeline.py).
        "$(rootpath //datalib/backend/etl/providers/yolink:yolink_make_fixture)",
        "datalib/backend/etl/providers/yolink/tests/fixtures/yolink_tng/tng.json",
        # PDF corpus (arg 23, appended for the same reason as 21-22).
        "datalib/backend/etl/providers/pdf/tests/fixtures/pdf_tng",
    ],
    data = [
        "run_sync_pipeline.py",
        ":source_json",
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        "//datalib/backend/signal-backup:signal_make_fixture",
        "//datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture",
        "//datalib/backend/etl/providers/yolink:yolink_make_fixture",
        "//third-party/doltlite:doltlite",
    ],
)

# Build a QMD (BM25 + embeddings) index over the rendered TNG markdown tree
# and emit it as an overlay tar on top of `:ingested_tng`'s qmd.tar.
#
# Output `qmd-index.tar` mirrors qmd.tar's layout: paths rooted at `qmd/`,
# so extracting both archives into the same directory (e.g. with
# `tar -x --strip-components=1`) yields a complete root data directory —
# markdown tree plus `.datalib/qmd/index.sqlite`.
#
# Caveats:
#   * Needs NO host `node`, no npm registry access, and no network at
#     all. Node and the qmd package tree are Bazel inputs (see
#     //third-party/qmd/runtime), which the driver symlinks into a
#     `DATALIB_RUNTIME_DIR` layout so the indexer resolves them instead
#     of shelling out to `npx`. The embedding model is a Bazel input too
#     (`@qmd_model_embeddinggemma`, pinned in MODULE.bazel), staged into
#     a models dir inside the sandbox — so this action no longer reads
#     the host's `~/.cache/qmd/models`, and no longer downloads it on a
#     machine where that cache is cold (which is every CI run).
#   * Embeds only; it does not `qmd pull`. Pull exists to put the query
#     expansion and reranker models in place for interactive querying,
#     which the fixture never does — and it is also the step that would
#     re-download our staged model, since it treats "cached file whose
#     etag I cannot confirm" as stale. The driver passes `--no-pull`.
#   * SQLite output is NOT byte-stable across runs (timestamps, packing).
#     This rule is correctness-only. That does not stop it from being
#     CACHEABLE, though — bazel keys an action on its inputs, never on
#     whether its outputs are reproducible, so serving a previously
#     computed index for identical inputs is sound. See the `tags` note.
QMD_VERSION = "2.8.3"

genrule(
    name = "ingested_tng_qmd",
    srcs = [
        "ingested/qmd.tar",
        # The embedding model `qmd embed` loads. See MODULE.bazel for why
        # it is fetched by bazel rather than by qmd, and why its filename
        # has to stay `hf_ggml-org_embeddinggemma-300M-Q8_0.gguf`.
        "@qmd_model_embeddinggemma//file",
    ],
    outs = ["ingested/qmd-index.tar"],
    tools = [
        "//datalib/backend/qmd_indexer:qmd_indexer_bin",
        "build_qmd_index.py",
        # Node itself plus the Bazel-managed qmd package tree. The
        # driver symlinks these into a `DATALIB_RUNTIME_DIR` layout,
        # which is what stops the indexer falling back to
        # `npx -y @tobilu/qmd@<v>`.
        "@nodejs_host//:node_bin",
        "//third-party/qmd/runtime:qmd_tree",
        "//third-party/qmd/runtime:qmd_package_dir",
    ],
    cmd = " ".join([
        "python3 $(execpath build_qmd_index.py)",
        "$(execpath //datalib/backend/qmd_indexer:qmd_indexer_bin)",
        "$(execpath ingested/qmd.tar)",
        "$(execpath ingested/qmd-index.tar)",
        QMD_VERSION,
        "$(execpath @nodejs_host//:node_bin)",
        "$(execpath //third-party/qmd/runtime:qmd_package_dir)",
        "$(execpath @qmd_model_embeddinggemma//file)",
    ]),
    tags = [
        # No `requires-network`, deliberately. It was here for the model
        # download, which is now `@qmd_model_embeddinggemma` — a bazel
        # input, fetched by the repository rule outside the action and
        # kept in the repository cache. The other thing this tag used to
        # cover, fetching qmd ITSELF, went away earlier: the package tree
        # is Bazel-managed and integrity-pinned (see
        # //third-party/qmd/runtime), so no npm registry traffic and no
        # install scripts happen here either.
        #
        # `no-remote-exec`, NOT `no-remote`. `no-remote` is shorthand for
        # no-remote-exec PLUS no-remote-cache, and that second half meant
        # every CI run recomputed the index from scratch: CPU-only
        # embedding of 80 chunks, 61-611s depending on how much else was
        # competing for the runner's 4 vCPUs. With the cache half
        # restored, a run whose rendered markdown is unchanged downloads
        # a ~3MB tar instead. Measured: 91s -> 0s on the CI critical
        # path.
        #
        # The exec half stays for a plainer reason than it had before —
        # the rule no longer needs the network or the host model cache,
        # so it *could* run remotely, but this repo configures a remote
        # CACHE only (see `.bazelrc`'s `buildbuddy` config) and has never
        # run a 300 MB-input, CPU-bound inference action on a remote
        # executor. Dropping the tag would change nothing today and would
        # be an untested change the day someone turns on RBE.
        "no-remote-exec",
    ],
    visibility = ["//visibility:public"],
)

# The progress bus, end to end, read by an engine that is not ours.
#
# Runs the real runner and opens `system/progress.sqlite` with Python's
# stdlib sqlite3 — a separate engine in a separate process that knows
# nothing about doltlite. Deliberately NOT folded into :ingested_tng:
# the bus carries live wall-clock heartbeats, and that fixture is the
# tree's deterministic, cacheable one.
py_test(
    name = "progress_bus_e2e_test",
    size = "small",
    srcs = ["progress_bus_e2e_test.py"],
    args = ["$(rootpath //datalib/backend/dag:datalib_dag_bin)"],
    data = ["//datalib/backend/dag:datalib_dag_bin"],
)
