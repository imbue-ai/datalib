# The `make_*.py` generators are exported so the SQLite-mirror
# fixture genrules (`//datalib/backend/etl/sqlite_mirror:tng_catalog`,
# `//datalib/backend/etl/providers/apple_photos:tng_library`) can reach
# them across the package boundary. They live here rather than beside
# those crates because `tests/fixtures` is one of the three
# PYTHON_LINT_ROOTS (see scripts/lint_repo.py) — and because AGENTS.md
# scopes Python in this repo to exactly this: fixture / test-pipeline
# tooling.
exports_files([
    "make_apple_mail_folder.py",
    "make_apple_messages_db.py",
    "make_apple_photos_library.py",
    "make_beeper_texts.py",
    "make_lightroom_catalog.py",
])

# This package's contribution to `//:python_sources` — glob can't cross a
# package boundary, so the root filegroup can't reach these itself. See
# the comment on `//:python_sources` for how omissions get caught.
filegroup(
    name = "python_sources",
    srcs = glob(["*.py"], allow_empty = False),
    visibility = ["//visibility:public"],
)

# Materialize a datalib data root from :ingested_tng and its search index
# into a caller-provided directory. One script for `//datalib:dev_tng`
# (interactive eyeballing) and the UI e2e suite (fixture setup), so the
# two can't drift apart. It carries the embedding model, which a search
# by meaning loads, and nothing else a root would fetch.
sh_binary(
    name = "materialize_tng_root",
    srcs = ["materialize_tng_root.sh"],
    data = [
        ":ingested_tng",
        ":ingested_tng_search_index",
        ":ingested_tng_inference_cache",
        # TNG-themed scan tree dropped into the root as `file_inventory_scan/` — a
        # directory the `file_inventory` (Unison-style) scanner can index. It's not
        # rendered (file_inventory is extract-only), so it just sits in the root.
        "//datalib/backend/etl/providers/file_inventory:tng_fixture",
        # The generated config declares the `unified_grid_and_search_index` applet, and
        # the gateway spawns it by the command written there. Naming the
        # binary's runfiles path keeps that resolvable without a
        # `binary_dir` or a PATH assumption.
        "//datalib/backend/applets:datalib_applet",
        "//third-party/embedding_models:embeddinggemma",
    ],
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Cacheable, ingested-fixture artifact.
#
# `bazelisk build //tests/fixtures:ingested_tng` runs the full
# pipeline (ingest -> render) against the checked-in TNG-themed source
# JSON and emits four outputs:
#
#   * backend_index.sqlite -- the grid index the backend reads (plain SQLite),
#                   its search terms included.
#   * rendered.tar -- each source's render store
#                   (indexed_markdown.doltlite_db, its render cursor
#                   inside) and blob store.
#   * rendered_md.tar -- every document's markdown as `datalib-step
#                   markdown` exports it, for the UI's render preview.
#   * config_body.toml -- every source as a render-only group plus the
#                   two fan-ins, for materialize_tng_root.sh to declare
#                   in the root it builds from the tars.

filegroup(
    name = "source_json",
    # Every provider's fixture lives in its own crate, beside the code
    # under test.
    srcs = [
        "//datalib/backend/etl/providers/github:tng_fixture",
        "//datalib/backend/etl/providers/gitlab:tng_fixture",
        "//datalib/backend/etl/providers/notion:tng_fixture",
        "//datalib/backend/etl/providers/slack:tng_fixture",
        "//datalib/backend/etl/providers/chatgpt:tng_fixture",
        "//datalib/backend/etl/providers/claude:tng_fixture",
        "//datalib/backend/etl/providers/beeper:tng_fixture",
        "//datalib/backend/etl/providers/contacts:tng_fixture",
        "//datalib/backend/etl/providers/email:tng_fixture",
        "//datalib/backend/etl/providers/signal:tng_fixture",
        "//datalib/backend/etl/providers/whatsapp:tng_fixture",
        "//datalib/backend/etl/providers/google_takeout:tng_fixture",
        "//datalib/backend/etl/providers/linkedin:tng_fixture",
        "//datalib/backend/etl/providers/sms_backup_restore:tng_fixture",
        "//datalib/backend/etl/providers/yolink:tng_fixture",
        "//datalib/backend/etl/providers/pdf:pdf_fixture",
        "//datalib/backend/etl/providers/garmin:tng_fixture",
        "//datalib/backend/etl/providers/airvisual:tng_fixture",
        "//datalib/backend/etl/providers/facebook:tng_fixture",
        "//datalib/backend/etl/providers/claude_code:tng_fixture",
        "//datalib/backend/etl/providers/codex:tng_fixture",
        "//datalib/backend/etl/providers/calendar:tng_fixture",
        "//datalib/backend/etl/providers/google_drive:tng_fixture",
    ],
    visibility = ["//visibility:public"],
)

# Cacheable, deterministic ingest of the TNG fixtures, driven through
# the server the way the web client drives it: `datalib-http` on the
# workspace, the config built with the Setup tab's endpoints and every
# sync a `POST /api/requests` (sync_drivers.py). `:ingested_tng_test`
# runs the same script through `datalib-dag`, so both doors are covered
# over the same fixture. The pipeline runs
# every source's download+render step pair over the checked-in
# fixtures and the index fan-in stacks the resulting render stores into
# `backend_index.sqlite` (doltlite is linked statically via
# `//third-party/doltlite:sqlite3`, so no host `dolt` install is required). This rule then tars the render_markdown tree into
# rendered.tar.
# Tar packaging is *not* the pipeline binary's concern — it operates
# at the layer of DB + rendered files.
#
# The pipeline binaries are `srcs`, not `tools`, on purpose. `tools` are
# configured for the exec platform, which would build `datalib_step` — and
# the 99 crates under it — a second time beside the copies the tests link
# and `:dist` ships. As `srcs` they are the same files the tests use. They
# arrive without their runfiles, which the playback pipeline never needs
# (`latchkey` resolution is lazy and only live downloads reach it).
genrule(
    name = "ingested_tng",
    srcs = [
        ":source_json",
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        "//datalib/backend/http:datalib_http_bin",
        # CLI that converts the signal TNG JSON spec into an encrypted
        # snapshot dir on the fly. Lives in the signal-backup library
        # crate; see that crate's BUILD.bazel.
        "//datalib/backend/signal-backup:signal_make_fixture",
        # Same idea for WhatsApp: spec → encrypted msgstore.db.crypt15 +
        # plaintext Media/. Root key defaults to 64 zeros, like the
        # signal fixture AEP.
        "//datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture",
        # Spec → seeded doltlite raw store. YoLink has no playback path
        # (its downloader shells out to `curl`), so the fixture pipeline
        # emits no download step and renders over the store this binary
        # writes.
        "//datalib/backend/etl/providers/yolink:yolink_make_fixture",
        # Reads the index back for check_ingested.py.
        "//third-party/doltlite:doltlite",
        # No embedding model: the sync runs no `embed`, and with fetching
        # off, a step that reached for the model would fail the build.
    ],
    outs = [
        "ingested/backend_index.sqlite",
        "ingested/rendered.tar",
        "ingested/rendered_md.tar",
        "ingested/time_series.tar",
        "ingested/config_body.toml",
        "ingested/sql_scans.jsonl",
    ],
    tools = [
        "check_ingested.py",
        "grid_alone.py",
        "make_beeper_texts.py",
        "quiet.sh",
        "run_sync_pipeline.py",
        "sql_scans.py",
        "sync_drivers.py",
        "tar_rendered.py",
    ],
    cmd = " && ".join([
        " ".join([
            # The sync's event stream goes to a log, printed only on
            # failure; see quiet.sh.
            "$(execpath quiet.sh) $(RULEDIR)/sync.log",
            "python3 $(execpath run_sync_pipeline.py)",
            "$(execpath //datalib/backend/dag:datalib_dag_bin)",
            "$(execpath //datalib/backend/datalib_step:datalib_step)",
            "$(execpath //datalib/backend/signal-backup:signal_make_fixture)",
            "$(execpath //datalib/backend/etl/providers/whatsapp:whatsapp_make_fixture)",
            "'2369-04-15T00:00:00+00:00'",
            "$(RULEDIR)/sync_workspace",
            "datalib/backend/etl/providers/claude/tests/fixtures/claude_export",
            "datalib/backend/etl/providers/chatgpt/tests/fixtures/chatgpt_api",
            "datalib/backend/etl/providers/slack/tests/fixtures/slack_api",
            "datalib/backend/etl/providers/github/tests/fixtures/github_api",
            "datalib/backend/etl/providers/gitlab/tests/fixtures/gitlab_api",
            "datalib/backend/etl/providers/notion/tests/fixtures/notion_web",
            # Beeper is different — the fixture is SQL + media, not
            # an HTTP capture tree. run_sync_pipeline.py
            # materializes a BeeperTexts-shaped dir from it on the
            # fly.
            "datalib/backend/etl/providers/beeper/tests/fixtures/beeper_tng",
            # Contacts (carddav) is translate-only in the fixture
            # pipeline: vCard files on disk feed the translate path
            # directly, no synth/extract for these. The directory
            # structure is `carddav_tng/<addressbook>/*.vcf`.
            "datalib/backend/etl/providers/contacts/tests/fixtures/carddav_tng",
            # Signal is similar to beeper — the fixture is a JSON
            # spec; run_sync_pipeline.py runs signal_make_fixture on
            # it to produce the encrypted snapshot dir before invoking
            # extract.
            "datalib/backend/etl/providers/signal/tests/fixtures/signal_tng/tng.json",
            # WhatsApp: same shape as signal.
            "datalib/backend/etl/providers/whatsapp/tests/fixtures/whatsapp_tng/tng.json",
            # Email: Google Takeout mbox file. Drives the email
            # extract path (mbox → raw doltlite → translate → render).
            "datalib/backend/etl/providers/email/tests/fixtures/mbox/star_trek.mbox",
            # Google Takeout root. Google Chat feed renders; the rest land
            # in the raw store.
            "datalib/backend/etl/providers/google_takeout/tests/fixtures/Takeout",
            # LinkedIn export dir (Connections + messages + Skills). The
            # message feeds, posts, connections and skills render.
            "datalib/backend/etl/providers/linkedin/tests/fixtures/linkedin_tng",
            # "SMS Backup & Restore" export dir (sms + calls XML with
            # inline base64 image/audio attachments). Texts + calls
            # render as one chat per phone number.
            "datalib/backend/etl/providers/sms_backup_restore/tests/fixtures/sms_backup_restore_tng",
            # YoLink (args 21-22, appended — see run_sync_pipeline.py's
            # docstring for why these two aren't grouped with the rest).
            "$(execpath //datalib/backend/etl/providers/yolink:yolink_make_fixture)",
            "datalib/backend/etl/providers/yolink/tests/fixtures/yolink_tng/tng.json",
            # PDF corpus (arg 23, appended for the same reason as 21-22).
            "datalib/backend/etl/providers/pdf/tests/fixtures/pdf_tng",
            # Garmin (arg 24): the JSON spec the synthesizer expands.
            "datalib/backend/etl/providers/garmin/tests/fixtures/garmin_tng/tng.json",
            # AirVisual: two Pros' data folders (arg 25, appended likewise).
            "datalib/backend/etl/providers/airvisual/tests/fixtures/airvisual_tng",
            # Facebook export dir (arg 26, appended likewise). File-backed;
            # posts, an album, comments, reactions and friends render.
            "datalib/backend/etl/providers/facebook/tests/fixtures/facebook_tng",
            # Claude Code: a `~/.claude/projects` tree (arg 27, appended likewise).
            "datalib/backend/etl/providers/claude_code/tests/fixtures/claude_code_tng",
            # Codex: a `~/.codex` home (arg 28, appended likewise).
            "datalib/backend/etl/providers/codex/tests/fixtures/codex_tng",
            # Calendar: two `.ics` calendars (arg 29, appended likewise).
            "datalib/backend/etl/providers/calendar/tests/fixtures/calendar_tng",
            # Google Drive: the JSON spec the synthesizer expands (arg 30,
            # appended likewise).
            "datalib/backend/etl/providers/google_drive/tests/fixtures/google_drive_tng/tng.json",
            # The server every sync goes through (arg 31).
            "$(execpath //datalib/backend/http:datalib_http_bin)",
        ]),
        # Copy the grid index store out of the workspace.
        # It lives under the `unified_grid_and_search_index/` tree the index steps own
        # (see core::layout).
        "cp $(RULEDIR)/sync_workspace/unified_grid_and_search_index/unified_grid_and_search_index/db.sqlite $(execpath ingested/backend_index.sqlite)",
        # The grid alone: the sync's `unified_grid_and_search_index` step wrote the search index's
        # tables beside it, which `:ingested_tng_search_index` makes again.
        "python3 $(execpath grid_alone.py) $(execpath ingested/backend_index.sqlite)",
        # The sources as render-only groups, for materialize_tng_root.sh
        # to splice into the root's config.toml.
        "cp $(RULEDIR)/sync_workspace/config_body.toml $(execpath ingested/config_body.toml)",
        "python3 $(execpath sql_scans.py) $(RULEDIR)/sync_workspace/sql_census $(RULEDIR)/sync_workspace $(execpath ingested/sql_scans.jsonl)",
        # A sync can end without error and leave a source out of the
        # index; such a fixture must not build, or it is cached.
        " ".join([
            "python3 $(execpath check_ingested.py)",
            "$(execpath //third-party/doltlite:doltlite)",
            "$(execpath ingested/backend_index.sqlite)",
            "$(execpath ingested/config_body.toml)",
            "$(RULEDIR)/sync_workspace/unified_time_series_index/time_series_index/time_series.doltlite_db",
        ]),
        # Every document's markdown, spelled from its render store the
        # way a person exports it.
        "rm -rf $(RULEDIR)/exported_md",
        " ".join([
            "$(execpath //datalib/backend/datalib_step:datalib_step) markdown",
            "$(RULEDIR)/sync_workspace",
            "--out $(RULEDIR)/exported_md",
            "> /dev/null",
        ]),
        # Tar the render_markdown tree hermetically into rendered.tar, and
        # the exported markdown into rendered_md.tar. See tar_rendered.py
        # for why markdown alone gets its own archive.
        " ".join([
            "python3 $(execpath tar_rendered.py)",
            "$(RULEDIR)/sync_workspace",
            "$(execpath ingested/rendered.tar)",
            "$(execpath ingested/rendered_md.tar)",
            "$(execpath ingested/time_series.tar)",
            "$(RULEDIR)/exported_md",
        ]),
    ]),
    visibility = ["//visibility:public"],
)

