load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

exports_files([
    ".bazelrc",  # read by //tools:qmd_model_cache_path_test
    "MODULE.bazel",  # read by //third-party/qmd/runtime:node_abi_test
    "pyproject.toml",  # ruff + pyright config, read by //tools:ruff_test
    "requirements.txt",
])

# Every first-party Python file in the repo, as a single filegroup the
# hermetic lint tests consume.
#
# `third-party/` is deliberately absent for the same reason
# `[tool.ruff] extend-exclude` lists it: vendored subtrees are
# upstream-owned and get linted in their own repo.
#
# Why the split: `scripts/` is not a Bazel package, so the root package's
# glob reaches into it. `tests/fixtures/` IS a package, and glob never
# crosses a package boundary, so it contributes its own filegroup. A new
# Python file inside a NEW package therefore needs a filegroup there plus
# an entry here, or it silently goes unlinted.
#
# `scripts/lint_repo.py` catches that omission: it asks git for every
# tracked first-party `*.py` and diffs against what these filegroups
# actually reach. It can't run as a Bazel test — enumerating "every file
# in the repo" is exactly what a sandbox denies — so it runs as a plain
# step in `test.yml` and in `bazel run //:precommit`.
filegroup(
    name = "python_sources",
    srcs = glob(["scripts/**/*.py"]) + [
        "//tests/fixtures:python_sources",
        "//tools:python_sources",
    ],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "all_tests",
    tests = [
        "//datalib/backend/core:core_unittests",
        "//datalib/backend/http:http_unittests",
        "//datalib/backend/schema:schema_unittests",
    ],
)

# Interactive pre-commit wrapper: `bazelisk run //:precommit`.
#
# There is deliberately no `precommit_test` sibling any more. It used to
# exist so `bazel test //...` caught lint/fmt problems, but it carried
# `no-sandbox` + `requires-network` + `env_inherit = ["PATH", "HOME"]`
# and ran `scripts/run_checks.sh` against the real source tree — which
# meant a plain `bazel test //...` executed host `uv`/`pnpm`/`npx`,
# resolving ruff, pyright, and vue-tsc from PyPI and npm at test time
# with the developer's actual `$HOME`. Any edit to the shell script
# inherited that reach.
#
# The checks it gated are now three ordinary sandboxed Bazel tests, all
# in the default `bazel test //...` set and all remote-cacheable:
#
#   //tools:ruff_test            ruff, from hash-pinned requirements.txt
#   //tools/lint:pyright_test    pyright, from an integrity-pinned npm lock
#   //datalib/ui:typecheck_test  vue-tsc, from the UI's pnpm lock
#
# So the gate got STRONGER, not weaker: the old comment here worried that
# tagging it `external` would "silently let fmt regressions through", and
# these targets can't be skipped that way because there is nothing
# non-hermetic left to skip. What remains host-bound is the repo-hygiene
# lint (`scripts/lint_repo.py`, which must enumerate the whole repo) and
# clippy; both run from this wrapper and from CI.
# The hygiene lint, run under Bazel's pinned interpreter rather than
# whatever `python3` the host happens to have. It needs `tomllib`, i.e.
# Python >= 3.11, and macOS still ships 3.9 as `python3` — so invoking
# it directly made `bazel run //:precommit` fail with a bare
# `ModuleNotFoundError` on every Mac, which reads like a broken script
# rather than a stale interpreter.
#
# Still not a `bazel test`: it enumerates the whole repo via
# `git ls-files`, which is what a sandbox exists to prevent. This target
# only fixes *which Python* runs it.
py_binary(
    name = "lint_repo",
    srcs = ["scripts/lint_repo.py"],
    data = ["pyproject.toml"],
    main = "scripts/lint_repo.py",
    visibility = ["//visibility:public"],
)

sh_binary(
    name = "precommit",
    srcs = ["scripts/run_checks.sh"],
    data = [
        "pyproject.toml",
        ":lint_repo",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# The hermetic lint/typecheck gate, grouped for `bazelisk test //:lint`.
test_suite(
    name = "lint",
    tests = [
        "//datalib/ui:typecheck_test",
        "//tools:ruff_test",
        "//tools/lint:pyright_test",
    ],
)
