"""Repo-root Bzlmod module for datalib (formerly personal-mirror).

Version policy: 7-day burn-in. We avoid versions released in the last 7
days because hot releases are where regressions hide. When bumping a
bazel_dep or a toolchain, check the upstream release date and prefer
the newest version that is at least 7 days old. Today's working
reference (2026-09-03): rules_python 2.3.2, rules_rust 0.73.0,
Rust 1.98.0, Bazel 9.2.0. rules_rust 0.74.0 and protobuf 36.1 both
exist and are both deliberately not taken here: each was published
inside the burn-in window.

Bazel owns:
  - `datalib/backend/*` Rust crates (Extract/Translate/Load + HTTP)
  - `tests/fixtures/`       fixture genrule pipeline
  - (later) `schemas/`      cross-language types
  - (later) `datalib/ui/` Vue + Vitest

Bazel does NOT own:
  - The Tauri bundler (driven via cargo/pnpm directly)
  - OpenHost docker builds
  - The local `uv` venv used for editor/inner-loop work
"""

module(
    name = "datalib",
    version = "0.0.1",
)

# Rules Shell — provides sh_binary etc. (split out of bazel core in Bazel 8/9).
bazel_dep(name = "rules_shell", version = "0.8.0")

# Rules CC — needed for the cc_library that compiles doltlite's
# amalgamation. Pulled in transitively by rules_rust today but worth
# declaring explicitly since our own BUILD files use it directly.
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "platforms", version = "1.1.0")

# doltlite amalgamation — a single-translation-unit `doltlite.c` that
# bundles the SQLite core, the prolly-tree storage engine, the
# `dolt_commit`/`dolt_log`/… version-control SQL surface, and embedded
# blake3. Pinned to a sha so the fetch is one-time-per-pin; consumed
# by `//third-party/doltlite:sqlite3`.
#
# Prior to v0.11.4 the amalgamation zip was broken — it built stock
# SQLite without the prolly hooks — so we used to pull the autoconf
# source tarball and compile every `src/*.c` individually (see git
# history of //third-party/doltlite/amalgamation.BUILD for the
# ~300-line file-curation that took). v0.11.4 fixed the amalgamation
# pipeline, so we're back to the trivial single-file build.
#
# v0.50.3 is a deliberate exception to the 7-day burn-in above (it
# was published the day it was pinned), and it is the second one in a
# row — v0.11.53 before it carried dolthub/doltlite#2329, the fix for
# the silent large-value corruption we hit building the lightroom
# mirror (dolthub/doltlite#2327 — every value past the source file's
# local payload limit collapsed onto the first row's bytes when read
# out of a plain SQLite file). `hack/doltlite_blob_bug/run.sh` is
# still the check for that one: 1 distinct blob against the v0.11.52
# CLI, 3 against v0.11.53 and later.
#
# The 0.11.57 → 0.50.0 jump is a renumbering, not 39 minor versions of
# churn: upstream's own release note for 0.50.0 says "There are no code
# changes from 0.11.57". What it marks is DoltLite Beta, whose headline
# claim is storage-format stability — which is the property this repo
# cares about most, since every `.doltlite_db` under a user's data root
# has to stay readable. Taking it now rather than in a week is the
# point: the sooner the data roots are written by a format-stable
# release, the smaller the set of files written by a pre-Beta one.
#
# 0.11.54 through 0.11.57 are real fixes and come along for the ride:
# index corruption during merges and reverts (including keyless
# tables), secondary-index corruption when merging tables with explicit
# integer-PK index terms, and `VACUUM INTO`. `grid_index` merges on
# every run, so those are ours.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "doltlite_amalgamation",
    urls = ["https://github.com/dolthub/doltlite/releases/download/v0.50.3/doltlite-amalgamation-0.50.3.zip"],
    sha256 = "216ed94387cc7a5c8a07b1a72c412b3a2c8c2d22da6028eede7827fd3a9da639",
    strip_prefix = "doltlite-amalgamation-0.50.3",
    build_file = "//third-party/doltlite:amalgamation.BUILD",
)

# The autoconf source tarball, for its pre-generated `shell.c` — the
# sqlite3-shell entry point that `//third-party/doltlite:doltlite`
# links against the amalgamation to get a CLI for tests.
#
# The amalgamation cannot supply this: it is library-only — two files,
# no `main()` anywhere in `doltlite.c`. `shell.c` is generated from
# `src/shell.c.in` by the upstream build, and this tarball is the only
# release artifact shipping the generated result. We take exactly one
# file out of it; the rest of the tarball is never compiled.
#
# MUST move in lockstep with `doltlite_amalgamation` above: `shell.c`
# is generated against a specific doltlite version and reports it via
# `-DDOLTLITE_VERSION`. `//third-party/doltlite:cli_version_test`
# fails the build if the two pins drift.
http_archive(
    name = "doltlite_autoconf",
    urls = ["https://github.com/dolthub/doltlite/releases/download/v0.50.3/doltlite-autoconf-0.50.3.tar.gz"],
    sha256 = "fbe66215a3f214d92d1edab82d7125df8257690844541f9a75a3bc6435c2d714",
    strip_prefix = "doltlite-autoconf-0.50.3",
    build_file = "//third-party/doltlite:autoconf.BUILD",
)

