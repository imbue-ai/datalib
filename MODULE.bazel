# which ingests all four into one store and asserts the incremental
# diffs. That test is tagged `requires-network` — once fetched it is
# hermetic, but a cold cache needs to reach github.com.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

