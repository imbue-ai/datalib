load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# This package's contribution to `//:python_sources` — see the comment
# there for why each package with Python has to opt in by hand.
filegroup(
    name = "python_sources",
    srcs = glob(["*.py"], allow_empty = False),
    visibility = ["//visibility:public"],
)

exports_files([
    "check_cargo_lock_versions.sh",
    "check_qmd_model_cache_path.sh",
    "check_version_consistency.sh",
    "fetch_pinned.py",
    "insta_update.sh",
    "live_run.sh",
    "repin_cargo.sh",
    "test_slice.sh",
    "workspace_status.sh",
])

# --- release.yml's steps, run before a tag runs them ----------------
#
# The `runtime` job and the build job's "Stage tarball" step are the
# scripts under scripts/release/, and these run them the way the
# workflow does — from a directory that is not the repo, with relative
# paths — against the Bazel outputs as runfiles. docs/dev/release_steps.md
# says what they cover and what stays release-only.
#
# Each comes twice: once under whatever `bash` the sandbox finds, and
# once, on a mac only, under /bin/bash — the 3.2 the macOS runner has,
# where an empty array is "unbound variable" under -u (v0.35.0).
STAGE_RUNTIME_DATA = [
    "//:scripts/release/stage_runtime_asset.sh",
    "//:scripts/stage_runtime.sh",
    "//datalib/backend/runtime:src/node_runtime.rs",
    "//datalib/backend/runtime:src/qmd.rs",
    "//datalib/tauri:bundled_node",
    "//third-party:bundled_licenses",
    "//third-party/latchkey/runtime:latchkey_tree",
    "//third-party/qmd/runtime:qmd_tree",
]

STAGE_TARBALL_DATA = [
    "fake_cargo_about.sh",
    "//:scripts/latchkey-wrapper.sh",
    "//:scripts/release/stage_tarball.sh",
    "//:scripts/third_party_notices.sh",
    # `:bin` minus its stamped `git-hash`; check_stage_tarball.sh links
    # it in under the name the script expects. With `:bin` itself these
    # two minute-long tests would re-run on every commit.
    "//datalib/backend:bin_unstamped",
    "//datalib/ui:dist",
    "//third-party:bundled_licenses",
]

sh_test(
    name = "stage_runtime_test",
    size = "large",
    srcs = ["check_stage_runtime.sh"],
    data = STAGE_RUNTIME_DATA,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "stage_runtime_bash32_test",
    size = "large",
    srcs = ["check_stage_runtime.sh"],
    data = STAGE_RUNTIME_DATA,
    env = {"RELEASE_SHELL": "/bin/bash"},
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "stage_tarball_test",
    size = "large",
    srcs = ["check_stage_tarball.sh"],
    data = STAGE_TARBALL_DATA,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_test(
    name = "stage_tarball_bash32_test",
    size = "large",
    srcs = ["check_stage_tarball.sh"],
    data = STAGE_TARBALL_DATA,
    env = {"RELEASE_SHELL": "/bin/bash"},
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# The tests above, run on Linux from a mac: in the devcontainer, built
# from .devcontainer/Dockerfile for this host's arch, over the working
# tree, with the devcontainer's own cache volumes. A `run` target, not
# a test, because it needs the working tree and the host's docker
# daemon, and a cold first run builds the Linux binaries from scratch:
#   bazelisk run //tools:release_steps_docker
sh_binary(
    name = "release_steps_docker",
    srcs = ["release_steps_docker.sh"],
)

# Asserts that the vendored qmd snapshot and `default_models_dir()`
# agree on `~/.cache/qmd/models` (the upstream qmd default) — the path
# the SHIPPED app downloads models to. See
# check_qmd_model_cache_path.sh for the full rationale. Pairs with the
# rust-side unit test
# //datalib/backend/qmd_indexer:qmd_indexer_unittests.
sh_test(
    name = "qmd_model_cache_path_test",
    size = "small",
    srcs = ["check_qmd_model_cache_path.sh"],
    data = [
        "//datalib/backend/runtime:src/qmd.rs",
        "//third-party/qmd:package.json",
        "//third-party/qmd:src/llm.ts",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# --- Hermetic Python lint -------------------------------------------
#
# ruff, from the hash-pinned `//:requirements.txt` via `pip.parse`, NOT
# from a host `.venv` populated by `uv run` at test time. That is the
# whole point: this target sandboxes, needs no network and no host
# `$HOME`, and remote-caches. See tools/lint_python.py.
# `no-remote-exec`: ruff's EXE002 reads a file's mode bit, and a remote
# worker materializes every CAS input executable — so it fires on files
# that are 100644 in git. Cache still applies; only execution is pinned.
py_test(
    name = "ruff_test",
    size = "small",
    srcs = ["lint_python.py"],
    tags = ["no-remote-exec"],
    args = [
        "$(rootpath @py_pip//ruff:whl)",
        "$(rootpath //:pyproject.toml)",
        "$(rootpaths //:python_sources)",
    ],
    data = [
        "//:pyproject.toml",
        "//:python_sources",
        # The wheel is only an anchor for locating `bin/ruff`; this is
        # what materializes the executable itself. See lint_python.py.
        "@py_pip//ruff:extracted_whl_files",
        "@py_pip//ruff:whl",
    ],
    main = "lint_python.py",
)

# --- Cross-file version pin consistency -----------------------------
#
# One declarative table covering every version that is written down in
# more than one file. Replaces the per-family `check_*.sh` pattern, under
# which adding a pin meant writing a script — so the pins nobody wrote a
# script for (latchkey, the doltlite CLI, Playwright) went unchecked.
# Adding a family is now four lines in the table.
#
# `data` is the pin sites themselves. A site that moves makes this test
# fail with "does not exist" rather than silently stopping being checked.
py_test(
    name = "version_pins_test",
    size = "small",
    srcs = ["check_version_pins.py"],
    data = [
        "//tools/lint:package.json",
        "//.devcontainer:Dockerfile",
        "//:MODULE.bazel",
        "//:requirements.txt",
        "//datalib/backend/runtime:src/node_runtime.rs",
        "//datalib/backend/runtime:src/qmd.rs",
        "//datalib/ui:pnpm-lock.yaml",
        "//tests/fixtures:BUILD.bazel",
        "//third-party/doltlite:BUILD.bazel",
        "//third-party/qmd:package.json",
        "//third-party/latchkey/runtime:package.json",
        "//third-party/qmd/runtime:package.json",
    ],
    main = "check_version_pins.py",
)

# The qmd model pins (repo, revision, file, sha256) live in the build's
# fetch rule and in the Rust table the shipped binaries verify against.
py_test(
    name = "qmd_model_pins_test",
    size = "small",
    srcs = ["check_qmd_model_pins.py"],
    data = [
        "//datalib/backend/runtime:src/qmd.rs",
        "//third-party/qmd_models:BUILD.bazel",
    ],
    main = "check_qmd_model_pins.py",
)

# cargo-about (the release's third-party notices) must accept every
# license cargo-deny (the PR gate) allows, or a release fails where a
# PR passed.
py_test(
    name = "license_lists_test",
    size = "small",
    srcs = ["check_license_lists.py"],
    data = [
        "//datalib/backend:about.toml",
        "//datalib/backend:deny.toml",
        "//datalib/tauri:deny.toml",
    ],
    main = "check_license_lists.py",
)
