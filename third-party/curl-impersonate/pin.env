# The curl-impersonate we build and ship. Read by
# .github/workflows/curl-impersonate.yml, which builds this exact commit
# from source on our release runners and publishes the binaries as the
# GitHub release named RELEASE_TAG; MODULE.bazel then pins those
# binaries by sha256. //third-party/curl-impersonate:pin_test fails if
# the two drift.
#
# To bump: change UPSTREAM_TAG + UPSTREAM_COMMIT (read the diff of
# patches/ between the two tags first — that is the whole delta over
# upstream curl and BoringSSL), reset BUILD to 1, run the workflow, then
# copy the sha256s it prints into MODULE.bazel. Bump BUILD alone to
# rebuild the same upstream commit (a workflow fix, a new runner
# image): a published release is never overwritten.
UPSTREAM_TAG=v2.2.2
UPSTREAM_COMMIT=107d67f9f7a518334b1b11e4810637e70b2671a7
BUILD=1
RELEASE_TAG=curl-impersonate-v2.2.2-1
