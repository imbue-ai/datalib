# The license notices of the third-party binaries a release ships, in
# one directory: `scripts/third_party_notices.sh` copies it into the
# tarball's and the .app's `licenses/`, beside what cargo-about and the
# UI build generate for the Rust crates and the npm bundle.

CURL_IMPERSONATE_NOTICES = [
    "LICENSE-boringssl",
    "LICENSE-brotli",
    "LICENSE-curl",
    "LICENSE-curl-impersonate",
    "LICENSE-nghttp2",
    "LICENSE-nghttp3",
    "LICENSE-ngtcp2",
    "LICENSE-zlib",
    "LICENSE-zstd",
]

genrule(
    name = "bundled_licenses",
    srcs = [
        "//third-party/latchkey-curl-shims:licenses",
        "//third-party/doltlite:licenses",
        # The whole Node distribution: its BUILD exports the binaries and
        # nothing else, so LICENSE is only reachable through this
        # filegroup. Inputs are hashed, not copied; the cost is one pass.
        "@nodejs_host//:npm_files",
    ],
    outs = ["bundled_licenses/curl-impersonate/" + f for f in CURL_IMPERSONATE_NOTICES] + [
        "bundled_licenses/doltlite/APACHE_LICENSE",
        "bundled_licenses/doltlite/LICENSE.md",
        "bundled_licenses/node/LICENSE",
    ],
    cmd = """
        out=$(RULEDIR)/bundled_licenses
        mkdir -p $$out/curl-impersonate $$out/doltlite $$out/node
        for f in $(locations //third-party/latchkey-curl-shims:licenses); do
            cp $$f $$out/curl-impersonate/$$(basename $$f)
        done
        for f in $(locations //third-party/doltlite:licenses); do
            cp $$f $$out/doltlite/$$(basename $$f)
        done
        for f in $(locations @nodejs_host//:npm_files); do
            case $$f in */bin/nodejs/LICENSE) cp $$f $$out/node/LICENSE ;; esac
        done
        test -s $$out/node/LICENSE
    """,
    visibility = ["//visibility:public"],
)
