load("@npm_qmd//:defs.bzl", "npm_link_all_packages")

# The @tobilu/qmd pin, read by //tools:version_pins_test.
exports_files(["package.json"])

# The qmd CLI and its 277-package transitive tree, materialized from
# pnpm-lock.yaml. Replaces `npx -y @tobilu/qmd@<v>`: same packages, but
# every tarball is integrity-checked and no install script runs (see the
# empty `onlyBuiltDependencies` in package.json).
npm_link_all_packages(name = "node_modules")

# The qmd package tree, for consumers that stage a `DATALIB_RUNTIME_DIR`
# layout. Depending on the link target materializes the whole pnpm store
# under `<bazel-bin>/third-party/qmd/runtime/node_modules/`; the `/dir`
# alias below is a single-file-ish label consumers can pass to
# `$(execpath)` as an anchor to find that root without expanding all 277
# package paths into a command line.
alias(
    name = "qmd_package_dir",
    actual = "node_modules/@tobilu/qmd/dir",
    visibility = ["//visibility:public"],
)

# The ENTIRE package store, not just the `@tobilu/qmd` link. A consumer
# that stages this tree needs every package materialized: qmd resolves its
# dependencies from sibling directories inside
# `node_modules/.aspect_rules_js/`, and depending on the single qmd link
# target brings across only that one package directory.
alias(
    name = "qmd_tree",
    actual = ":node_modules",
    visibility = ["//visibility:public"],
)
