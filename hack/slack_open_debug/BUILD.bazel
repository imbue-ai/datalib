load("@rules_rust//rust:defs.bzl", "rust_binary")

# A/B between raw sqlite3_open_v2 (extern "C" against our doltlite static
# archive) and sqlx-pool open. Purpose: attribute the ~60s slack open
# observed by `datalib_etl::doltlite_raw::open` to either the C
# library + our compile flags (raw is slow) or sqlx wrapper machinery
# (raw is fast, sqlx is slow). No libsqlite3-sys involved — symbols
# come directly from the Bazel cc_library link.
rust_binary(
    name = "slack_open_debug",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    # The doltlite static archive is a cc_library, so it goes in
    # `link_deps` (manual FFI linkage) rather than `deps`, which takes
    # Rust targets only.
    link_deps = ["//third-party/doltlite:sqlite3"],
    deps = [
        "@datalib_crates//:clap",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)
