load("@rules_python//python:defs.bzl", "py_test")

# The imbue-datalib-reader package: the module people import and the page PyPI
# shows. Its wheels are built by scripts/release/stage_reader_wheels.sh
# (docs/dev/release_steps.md §"The reader wheels").
exports_files(
    ["datalib_reader.py"],
    visibility = ["//visibility:public"],
)

# This package's contribution to `//:python_sources`, which lints it.
filegroup(
    name = "python_sources",
    srcs = glob(["*.py"], allow_empty = False),
    visibility = ["//visibility:public"],
)

py_test(
    name = "reader_wheel_test",
    size = "small",
    srcs = ["reader_wheel_test.py"],
    args = [
        "$(rootpath //:scripts/release/make_reader_wheel.py)",
        "$(rootpath datalib_reader.py)",
        "$(rootpath README.md)",
        "$(rootpath //:LICENSE)",
        "$(rootpath //third-party/doltlite:LICENSE.md)",
        "$(rootpath //third-party/doltlite:APACHE_LICENSE)",
        "$(rootpath //third-party/doltlite:shipped_library)",
        "$(rootpath //third-party/doltlite:library_copts)",
        "$(rootpath //third-party/doltlite:doltlite)",
        "$(rootpath //docs/dev:doltlite.md)",
        "$(rootpath //docs/dev:step_protocol.md)",
    ],
    data = [
        "README.md",
        "datalib_reader.py",
        "//:LICENSE",
        "//:scripts/release/make_reader_wheel.py",
        "//docs/dev:doltlite.md",
        "//docs/dev:step_protocol.md",
        "//third-party/doltlite:APACHE_LICENSE",
        "//third-party/doltlite:LICENSE.md",
        "//third-party/doltlite:doltlite",
        "//third-party/doltlite:library_copts",
        "//third-party/doltlite:shipped_library",
    ],
    main = "reader_wheel_test.py",
)
