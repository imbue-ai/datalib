<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's own executable only; the bundled binaries are signed without
  it (sign-staged.sh). The one group is the
  protected folder a library can live in (src/protected.rs, GROUP_ID).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>LDDYAR29MP.com.imbue.datalib</string>
  </array>
</dict>
</plist>
