load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_rust//rust:defs.bzl", "rust_test")

# The Tauri shell itself is NOT built by Bazel — it is a standalone
# cargo workspace, deliberately, so crate_universe never has to resolve
# the tauri dependency tree (see Cargo.toml's `[workspace]` table and
# README.md).
#
# That leaves its logic outside `bazelisk test //...`, which AGENTS.md
# calls the source of truth. `src/launcher.rs` is the part where that
# matters — which data roots the welcome screen offers, and where a new
# one goes — so it is written free of `tauri` and compiled a second
# time here, as its own crate, purely to run the tests inside it. The
# shipping build still compiles it as a module of the shell; this
# target is the only thing that ever *runs* those tests.
#
# The rule for keeping this working: nothing in `launcher.rs` may
# reference `tauri` or any other module of the shell.
rust_test(
    name = "launcher_test",
    size = "small",
    srcs = ["src/launcher.rs"],
    crate_root = "src/launcher.rs",
    edition = "2021",
    deps = [
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
    ],
)

# The Node runtime that ships inside the .app, copied out of the
# rules_nodejs toolchain repo so it lands at a predictable
# `bazel-bin/datalib/tauri/` path — the same convention
# `tauri.conf.json`'s beforeBuildCommand already uses for the seven
# backend binaries it stages.
#
# The copy is what buys the predictable path: `@nodejs_host//:node_bin`
# lives in an external repo whose bzlmod-mangled name has no stable
# string form, and whose files resolve against the output base rather
# than bazel-bin. `stage-runtime.sh` is a plain shell script outside
# Bazel, so it needs a path it can write down.
copy_file(
    name = "bundled_node",
    src = "@nodejs_host//:node_bin",
    out = "bundled_node_bin",
    is_executable = True,
)
