  columns
    kind           Slack Thread
    channel        #bridge
  terms
    id         bridge-thread                            derived
    title      #bridge                                  derived
    name       #bridge                                  derived
    participant Q                                        supplied
    participant slack:T1701/U0000002                     supplied
    participant slack:T1701/U0000003                     supplied

