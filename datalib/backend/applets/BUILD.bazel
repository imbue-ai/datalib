load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//datalib/backend/unified_document_index:qmd_fixture.bzl", "QMD_FIXTURE_DATA", "QMD_FIXTURE_ENV")
load("//tools:insta.bzl", "insta_update")

# `datalib-applet` — the applet host (see docs/dev/applets.md), one
# subcommand per applet, the same shape as `datalib-step`.
#
# Deliberately dependency-light: applets query the cross-provider
# `grid_rows` table in a source's own render store rather than linking
# the provider crates, so writing one stays a small job.
rust_binary(
    name = "datalib_applet",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/**/*.js"]),
    crate_name = "datalib_applet",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//datalib/backend/columns:datalib_columns",
        "//datalib/backend/contact_schema:datalib_contact_schema",
        "//datalib/backend/contacts:datalib_contacts",
        "//datalib/backend/embedder:datalib_embedder",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/fetch:datalib_fetch",
        "//datalib/backend/handle:datalib_handle",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/parent_watch:datalib_parent_watch",
        "//datalib/backend/photo_schema:datalib_photo_schema",
        "//datalib/backend/pin:datalib_pin",
        "//datalib/backend/env:datalib_env",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl/time_series:datalib_etl_time_series",
        "//datalib/backend/sqlite_open:datalib_sqlite_open",
        "//datalib/backend/time_series_schema:datalib_time_series_schema",
        "//datalib/backend/qmd_indexer:datalib_qmd_indexer",
        "//datalib/backend/qmd_models:datalib_qmd_models",
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/search_index:datalib_search_index",
        "//datalib/backend/sql_guard:datalib_sql_guard",
        "//datalib/backend/unified_document_index:datalib_unified_document_index",
        "//datalib/backend/uri:datalib_uri",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:axum",
        "@datalib_crates//:base64",
        "@datalib_crates//:chrono",
        "//datalib/backend/cli_help:datalib_cli_help",
        "@datalib_crates//:clap",
        "@datalib_crates//:futures",
        "@datalib_crates//:serde",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:strum",
        "@datalib_crates//:sha2",
        "@datalib_crates//:tokio",
        "@datalib_crates//:toml",
        "@datalib_crates//:tracing",
    ],
)

# The unified_document_index applet's searches run a real `qmd mcp` over the TNG
# fixture, so this carries the fixture and a staged qmd; and the applet
# binary itself, which serve_tests.rs starts the way the gateway does.
rust_test(
    name = "applet_unittests",
    size = "medium",
    crate = ":datalib_applet",
    data = glob(["src/unified_document_index/snapshots/*.snap"], allow_empty = True) +
           QMD_FIXTURE_DATA + [":datalib_applet"],
    edition = "2021",
    env = QMD_FIXTURE_ENV | {
        "APPLET_BIN": "$(rootpath :datalib_applet)",
        "INSTA_WORKSPACE_ROOT": ".",
        # The qmd tests share `DATALIB_RUNTIME_DIR` (qmd_search_tests.rs).
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        "//datalib/backend/agent_docs:datalib_agent_docs",
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/contact-common:datalib_etl_contact_common",
        "//datalib/backend/unified_document_index:qmd_fixture",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/table:datalib_table",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:insta",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tower",
    ],
)

insta_update(
    name = "applet_unittests.update",
    extra_data = QMD_FIXTURE_DATA + [":datalib_applet"],
    extra_env = QMD_FIXTURE_ENV | {
        "APPLET_BIN": "$(rootpath :datalib_applet)",
        "RUST_TEST_THREADS": "1",
    },
    test = ":applet_unittests",
)

# The photos applet as the gateway runs it, over catalog 03 of
# github.com/thadd3us/lightroom_db_diff and its previews (the
# `lightroom_catalog_03_previews` archive in MODULE.bazel).
# `requires-network` for a cold cache, as the lightroom tests.
rust_test(
    name = "photos_catalog_03",
    size = "medium",
    srcs = ["tests/photos_catalog_03.rs"],
    crate_name = "photos_catalog_03",
    data = [
        ":datalib_applet",
        "@lightroom_catalog_03_previews//:catalog_03",
        "@lightroom_catalog_03_previews//:lrcat",
    ],
    edition = "2021",
    env = {
        "APPLET_BIN": "$(rootpath :datalib_applet)",
        "LIGHTROOM_CATALOG_03": "$(rootpath @lightroom_catalog_03_previews//:lrcat)",
    },
    tags = [
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        "//datalib/backend/env:datalib_env",
        "//datalib/backend/photo_schema:datalib_photo_schema",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# The applets' card components as the browser runs them, for the UI's
# unit tests (`datalib/ui/tests/untrusted_card_args.test.ts`).
copy_to_bin(
    name = "card_components",
    srcs = glob(["src/**/*.js"]),
    visibility = ["//datalib/ui:__pkg__"],
)
