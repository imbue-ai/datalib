load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Puts qmd's pinned GGUF models in place and verifies them, so qmd never
# reaches HuggingFace on its own. Linked by the `qmd_index` step and the
# search applet — NOT by //datalib/backend/qmd_indexer, which is a tool
# input to the fixture's ~90s embed action and must stay tiny.
rust_library(
    name = "datalib_qmd_models",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_qmd_models",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/fetch:datalib_fetch",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/runtime:datalib_runtime",
        "@datalib_crates//:anyhow",
    ],
)

rust_test(
    name = "qmd_models_unittests",
    size = "small",
    crate = ":datalib_qmd_models",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)
