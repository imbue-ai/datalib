load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")

# The Signal backup wire format, generated from upstream's compiled
# descriptor rather than vendored (Signal-Android is AGPL-3.0; see
# proto/PROTO_PROVENANCE.md). Two files because Signal splits the
# "envelope" (local_archive.proto: metadata + files sidecar) from the
# frame stream itself (backup.proto: BackupInfo + Frame).
proto_library(
    name = "signal_backup_proto",
    srcs = [
        "proto/backup.proto",
        "proto/local_archive.proto",
    ],
    strip_import_prefix = "/datalib/backend/signal-backup/proto",
)

rust_prost_library(
    name = "signal_backup_rust_proto",
    proto = ":signal_backup_proto",
    visibility = ["//visibility:private"],
)

rust_library(
    name = "datalib_signal_backup",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_signal_backup",
    edition = "2021",
    proc_macro_deps = [],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":signal_backup_rust_proto",
        "@datalib_crates//:aes",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:cbc",
        "@datalib_crates//:cipher",
        "@datalib_crates//:ctr",
        "@datalib_crates//:flate2",
        "@datalib_crates//:hkdf",
        "@datalib_crates//:hmac",
        "@datalib_crates//:prost",
        "@datalib_crates//:sha2",
        "@datalib_crates//:subtle",
    ],
)

# CLI used by the TNG fixture genrule (see
# //datalib/backend/etl/providers/signal). Takes a JSON spec +
# output directory; emits an encrypted snapshot. Lives in the library
# crate so it has direct access to the writer + protos.
rust_binary(
    name = "signal_make_fixture",
    srcs = ["src/bin/signal_make_fixture.rs"],
    edition = "2021",
    # Consumed by //tests/fixtures:ingested_tng (outside the
    # //datalib tree) so visibility is public — the binary takes a
    # spec file path + output dir, so there's no sensitive surface to
    # gate on package.
    visibility = ["//visibility:public"],
    deps = [
        ":datalib_signal_backup",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
    ],
)

rust_test(
    name = "signal_backup_unittests",
    size = "small",
    crate = ":datalib_signal_backup",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# Env-gated end-to-end test: skipped silently unless both
# SIGNAL_BACKUP_AEP and SIGNAL_BACKUP_SNAPSHOT are set in the
# environment, so `bazel test //...` stays green for everyone.
rust_test(
    name = "signal_backup_e2e",
    srcs = ["tests/e2e.rs"],
    crate_root = "tests/e2e.rs",
    edition = "2021",
    # Hermetic by default; users opt in via `--test_env`.
    tags = ["manual"],
    deps = [
        ":datalib_signal_backup",
    ],
)

# `manual` keeps these out of `//...`, so nothing else ever builds them.
# See scripts/lint_repo.py check 7.
build_test(
    name = "manual_targets_build",
    targets = [
        ":signal_backup_e2e",
    ],
)
