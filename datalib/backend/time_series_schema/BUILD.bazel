load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# A time series and the two tables that store one: the shape every
# time-series store and the time-series index share. Bazel-only.
rust_library(
    name = "datalib_time_series_schema",
    srcs = [
        "src/lib.rs",
        "src/points.rs",
        "src/series.rs",
    ],
    crate_name = "datalib_time_series_schema",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "@datalib_crates//:blake3",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:strum",
    ],
)

rust_test(
    name = "time_series_schema_unittests",
    size = "small",
    crate = ":datalib_time_series_schema",
    edition = "2021",
    deps = ["@datalib_crates//:serde_json"],
)
