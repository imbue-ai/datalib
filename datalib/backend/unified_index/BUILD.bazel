load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# The unified index: the grid index, the qmd index, and the query
# language over them.
#
# Visibility is the point of this crate existing. Only the step that
# writes the indexes and the applet that serves them may link it —
# `datalib-http` and `datalib-dag` must not, which is what makes "core
# does not know about the unified index" checkable rather than a
# convention.
rust_library(
    name = "datalib_unified_index",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_unified_index",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "unified_index_unittests",
    size = "small",
    crate = ":datalib_unified_index",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# The qmd index-state reader, against the REAL qmd index the fixture
# builds. Guards the one claim the grid's Indexed / Embedded columns
# rest on: `documents.hash` is the SHA-256 of the rendered file's
# bytes, so a grid row can be joined to a qmd document without
# reimplementing qmd's `handelize` path mangling. Both fixtures are
# already inputs to //datalib/ui:e2e_test, so this adds no new work to
# `bazel test //...`.
rust_test(
    name = "qmd_index_state_test",
    srcs = ["tests/qmd_index_state.rs"],
    data = [
        "//tests/fixtures:ingested/backend_index.doltlite_db",
        "//tests/fixtures:ingested/qmd.tar",
        "//tests/fixtures:ingested/qmd-index.tar",
    ],
    edition = "2021",
    deps = [
        ":datalib_unified_index",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

