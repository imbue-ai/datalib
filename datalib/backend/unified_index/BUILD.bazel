load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")
load(":qmd_fixture.bzl", "QMD_FIXTURE_DATA", "QMD_FIXTURE_ENV")

exports_files(["Cargo.toml"])

# The unified index: the grid index, the qmd index, and the query
# language over them.
#
# Visibility is the point of this crate existing. Only the step that
# writes the indexes and the applet that serves them may link it —
# `datalib-http` and `datalib-dag` must not, which is what makes "core
# does not know about the unified index" checkable rather than a
# convention.
rust_library(
    name = "datalib_unified_index",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_unified_index",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/columns:datalib_columns",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/pin:datalib_pin",
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "unified_index_unittests",
    size = "small",
    crate = ":datalib_unified_index",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# The TNG fixture's data root and a Bazel-staged qmd to search it with,
# for tests here and in the applet that run a real `qmd mcp`.
rust_library(
    name = "qmd_fixture",
    testonly = True,
    srcs = ["tests/qmd_fixture/lib.rs"],
    crate_name = "datalib_qmd_fixture",
    edition = "2021",
    visibility = ["//datalib/backend/applets:__pkg__"],
    deps = [
        "//datalib/backend/runtime:datalib_runtime",
        "@datalib_crates//:runfiles",
    ],
)

# Every hermetic unified-index test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "unified_index_tests",
    srcs = glob(["tests/unified_index_tests/*.rs"]),
    crate_root = "tests/unified_index_tests/main.rs",
    data = glob(["tests/unified_index_tests/snapshots/*.snap"], allow_empty = True) + QMD_FIXTURE_DATA,
    edition = "2021",
    env = QMD_FIXTURE_ENV | {
        "INSTA_WORKSPACE_ROOT": ".",
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        ":qmd_fixture",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/table:datalib_table",
        ":datalib_unified_index",
        "@datalib_crates//:insta",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)



# (The documented example configs are validated by
# //datalib/backend/datalib_step:datalib_step_unittests, which plans
# them through the real dispatcher.)


insta_update(
    name = "unified_index_tests.update",
    test = ":unified_index_tests",
)

