    {
      "bucket_key": "00000000-0000-89a0-9bd6-7e928c9b2396",
      "created_at": "2369-05-28T15:21:42+00:00",
      "kind": "thread",
      "markdown_uuid": "00000000-0000-89a0-9bd6-7e928c9b2396",
      "md_path": "slack/render_markdown/00000000-0000-89a0-9bd6-7e928c9b2396/all.md",
      "modified_at": "2369-05-28T15:21:42+00:00",
