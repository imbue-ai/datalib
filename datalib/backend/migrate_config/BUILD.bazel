load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# `datalib-migrate-config` — rewrites a `config.toml` from a shape nothing
# writes any more into the one the wizard writes.
#
# This package is the one place a retired config shape is *rewritten*.
# The runner refuses most old shapes, naming this tool. One rewrite is
# safe to make unattended — the qmd steps, a text edit that keeps the
# file as written — and `datalib-http` makes it itself on seeing the old
# shape (`upgrade_qmd_steps`). It holds one rewrite at a time, "any
# earlier shape → the current one"; the next shape change extends it.
rust_library(
    name = "datalib_migrate_config",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "datalib_migrate_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/dag:datalib_dag",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:toml",
    ],
)

rust_test(
    name = "migrate_config_unittests",
    size = "small",
    crate = ":datalib_migrate_config",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

rust_binary(
    name = "datalib_migrate_config_bin",
    srcs = ["src/main.rs"],
    crate_name = "datalib_migrate_config_bin",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":datalib_migrate_config",
        "@datalib_crates//:anyhow",
    ],
)
