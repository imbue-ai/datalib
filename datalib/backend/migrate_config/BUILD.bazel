load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# `datalib-migrate-config` — rewrites a `config.toml` from a shape nothing
# writes any more into the one the wizard writes.
#
# This package is the one place a retired config shape is *rewritten*.
# The runner refuses most old shapes, naming this tool. The rewrites safe
# to make unattended, text edits that keep the file as written, are
# listed in `UNATTENDED`, and `datalib-http` makes them itself on seeing
# an old shape. It holds one rewrite at a time, "any earlier shape → the
# current one"; the next shape change extends it.
rust_library(
    name = "datalib_migrate_config",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "datalib_migrate_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/dag:datalib_dag",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:toml",
    ],
)

rust_test(
    name = "migrate_config_unittests",
    size = "small",
    crate = ":datalib_migrate_config",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

rust_binary(
    name = "datalib_migrate_config_bin",
    srcs = ["src/main.rs"],
    crate_name = "datalib_migrate_config_bin",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":datalib_migrate_config",
        "//datalib/backend/cli_help:datalib_cli_help",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
    ],
)

# The command line's parse: its `--help` examples, and the commands the
# docs `datalib-step help` prints show for it.
rust_test(
    name = "migrate_config_bin_unittests",
    size = "small",
    crate = ":datalib_migrate_config_bin",
    edition = "2021",
    deps = ["//datalib/backend/agent_docs:datalib_agent_docs"],
)
