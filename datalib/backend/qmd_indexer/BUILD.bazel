load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "datalib_qmd_indexer",
    srcs = [
        "src/embed.rs",
        "src/lib.rs",
        "src/store.rs",
    ],
    crate_name = "datalib_qmd_indexer",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    # DELIBERATELY AS SMALL AS IT CAN BE, and please keep it that way.
    #
    # `:qmd_indexer_bin` is a bazel `tools=` input to
    # //tests/fixtures:ingested_tng_qmd, and bazel keys an action on its
    # tools' digests. So this list is not just "what the code needs" —
    # transitively, it IS the set of crates whose next edit re-runs a
    # ~90s CPU-only embed of the whole fixture corpus on CI (61-611s,
    # depending on what else is competing for the runner's 4 vCPUs).
    # Every entry here, and everything it pulls in, is a standing tax on
    # unrelated PRs.
    #
    # It used to name datalib_core (160 rdeps, 85 test targets) and
    # datalib_unified_index — to reach a version constant, two path joins
    # and a Command builder. Those now live in datalib_runtime, which has
    # no dependencies at all. Both crates named below carry a matching
    # note saying that editing them costs a re-embed.
    #
    # Before adding a crate here: put the helper in `datalib_runtime` (or
    # re-export it through there) instead. Adding a dep is the move that
    # quietly undoes all of this.
    #
    # The third-party crates below are pinned by the lockfile and never
    # edited, so they cost one re-embed when the pin moves and nothing
    # per PR. sqlx is how the index is written (this crate is qmd's
    # writer for one collection — see src/store.rs), and it is what
    # links the doltlite amalgamation every other binary uses, whose
    # FTS5 is what makes qmd's triggers fire.
    deps = [
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/runtime:datalib_runtime",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:libc",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:walkdir",
    ],
)

rust_test(
    name = "qmd_indexer_unittests",
    crate = ":datalib_qmd_indexer",
    deps = ["@datalib_crates//:tempfile"],
)

# The claim the per-source index rests on — that a collection this crate
# writes is one qmd itself would report `unchanged` — plus the two qmd
# behaviors the embed loop reads off qmd's output. Needs node, the qmd
# tree and the embedding model, all as bazel inputs (see the same
# arrangement in //datalib/backend/unified_index:qmd_daemon_scope_test).
rust_test(
    name = "index_group_test",
    size = "large",
    srcs = ["tests/index_group.rs"],
    data = [
        "//tests/fixtures:ingested/qmd_md.tar",
        "@nodejs_host//:node_bin",
        "//third-party/qmd/runtime:qmd_package_dir",
        "//third-party/qmd/runtime:qmd_tree",
        "@qmd_model_embeddinggemma//file",
    ],
    edition = "2021",
    env = {
        "QMD_TEST_NODE_RLOC": "$(rlocationpath @nodejs_host//:node_bin)",
        "QMD_TEST_QMD_DIR_RLOC": "$(rlocationpath //third-party/qmd/runtime:qmd_package_dir)",
        "QMD_TEST_EMBED_MODEL_RLOC": "$(rlocationpath @qmd_model_embeddinggemma//file)",
    },
    deps = [
        ":datalib_qmd_indexer",
        "//datalib/backend/runtime:datalib_runtime",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

rust_binary(
    name = "qmd_indexer_bin",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        ":datalib_qmd_indexer",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:tokio",
    ],
)
