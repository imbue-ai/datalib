load("@py_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The doltlite facts datalib depends on (docs/dev/doltlite.md), one test
# each. Run it after every doltlite bump; a fact that moved fails by name.
rust_test(
    name = "doltlite_facts_test",
    size = "small",
    srcs = ["doltlite_facts.rs"],
    data = [
        "wal_fixture/wal.sqlite",
        "wal_fixture/wal.sqlite-wal",
        "//third-party/doltlite:doltlite",
    ],
    edition = "2021",
    env = {
        "DOLTLITE_BIN": "$(rootpath //third-party/doltlite:doltlite)",
        "WAL_FIXTURE_DIR": "datalib/backend/doltlite_facts/wal_fixture",
    },
    deps = [
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# This package's contribution to `//:python_sources`, which lints it.
filegroup(
    name = "python_sources",
    srcs = glob(["*.py"], allow_empty = False),
    visibility = ["//visibility:public"],
)

# What docs/dev/doltlite.md tells a Python program to do, with the PyPI
# wheel at the pinned version. An sh_test so it runs the host's python3:
# the interpreter rules_python brings compiles SQLite in, and the package
# cannot replace it there. CI's devcontainer and a mac with Xcode's
# command line tools both have a python3 it works under.
sh_test(
    name = "python_package_test",
    size = "small",
    srcs = ["python_package_test.py"],
    data = [
        "//docs/dev:doltlite.md",
        "//third-party/doltlite:doltlite",
        requirement("doltlite"),
    ],
    env = {
        "DOLTLITE_BIN": "$(rootpath //third-party/doltlite:doltlite)",
        "DOLTLITE_DOC": "$(rootpath //docs/dev:doltlite.md)",
        "DOLTLITE_WHEEL_FILES": "$(rootpaths %s)" % requirement("doltlite"),
    },
)

# The reader docs/dev/doltlite.md tells a Python program to save, as written.
# A py_test because it is the interpreter rules_python brings, the one the
# package cannot take over, that the reader has to work under.
py_test(
    name = "python_reader_test",
    size = "small",
    srcs = ["python_reader_test.py"],
    args = [
        "$(rootpath //third-party/doltlite:doltlite)",
        "$(rootpath //docs/dev:doltlite.md)",
    ],
    data = [
        "//docs/dev:doltlite.md",
        "//third-party/doltlite:doltlite",
    ],
    main = "python_reader_test.py",
    deps = [requirement("doltlite")],
)
