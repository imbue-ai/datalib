load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "datalib_schema",
    srcs = [
        "src/lib.rs",
        "src/grid_rows.rs",
        "src/grid_rows_builder.rs",
        "src/edges.rs",
        "src/markdowns.rs",
    ],
    crate_name = "datalib_schema",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
    ],
)

rust_test(
    name = "schema_unittests",
    size = "small",
    crate = ":datalib_schema",
    edition = "2021",
)
