load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "datalib_schema",
    srcs = [
        "src/lib.rs",
        "src/grid_rows.rs",
        "src/grid_rows_builder.rs",
        "src/edges.rs",
        "src/search_terms.rs",
        "src/supplied_search_terms.rs",
        "src/markdowns.rs",
        "src/providers.rs",
        "src/source_cursors.rs",
        "src/render_cursor.rs",
        "src/render_inputs.rs",
        "src/measurements.rs",
        "src/diff_status.rs",
        "src/source_contact_handles.rs",
        "src/source_contacts.rs",
        "src/plain_text.rs",
    ],
    crate_name = "datalib_schema",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        # `PortableTable` emits `impl ::datalib_table::BulkUpsertable`.
        "//datalib/backend/problems:datalib_problems",
        # `search(...)` on a table emits `impl ::datalib_query::table::SearchTable`.
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/table:datalib_table",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:blake3",
        "@datalib_crates//:serde",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
    ],
)

rust_test(
    name = "schema_unittests",
    size = "small",
    crate = ":datalib_schema",
    edition = "2021",
    deps = [
        "@datalib_crates//:serde_json",
    ],
)
