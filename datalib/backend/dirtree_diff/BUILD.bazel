load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "datalib_dirtree_diff",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = ["viewer.html.tmpl"],
    crate_name = "datalib_dirtree_diff",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/pin:datalib_pin",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tracing",
    ],
)

# `datalib-dirtree-diff` once staged by `//datalib/backend:bin`.
rust_binary(
    name = "dirtree_diff",
    srcs = ["src/bin/dirtree_diff.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_dirtree_diff",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Inline unit tests: the byte-size parser, the `path#ref` parser, the
# commit-hash newtype that guards SQL interpolation, and the template
# projection.
rust_test(
    name = "dirtree_diff_unittests",
    size = "small",
    crate = ":datalib_dirtree_diff",
    edition = "2021",
)

# Every hermetic dirtree_diff test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "dirtree_diff_tests",
    srcs = glob(["tests/dirtree_diff_tests/*.rs"]),
    crate_root = "tests/dirtree_diff_tests/main.rs",
    edition = "2021",
    deps = [
        "//datalib/backend/etl/providers/fsindex:datalib_etl_fsindex",
        ":datalib_dirtree_diff",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:hex",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

