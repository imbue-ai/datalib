load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

# `datalib-step` — the step-type host binary for the DAG runner
# (//datalib/backend/dag:datalib_dag_bin). One subcommand per step
# type: download / render / grid_index / qmd_index, each honoring the DAG step
# contract (NDJSON events on stdout, final outcome line).
#
# Bazel-only: it links the provider crates, which have no cargo
# counterpart.
rust_binary(
    name = "datalib_step",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_step",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/unified_index:datalib_unified_index",
        "//datalib/backend/dag:datalib_dag",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/claude:datalib_etl_claude",
        "//datalib/backend/etl/providers/claude_config:datalib_etl_claude_config",
        "//datalib/backend/etl/providers/beeper:datalib_etl_beeper",
        "//datalib/backend/etl/providers/beeper_config:datalib_etl_beeper_config",
        "//datalib/backend/etl/providers/carddav_config:datalib_etl_carddav_config",
        "//datalib/backend/etl/providers/chatgpt:datalib_etl_chatgpt",
        "//datalib/backend/etl/providers/chatgpt_config:datalib_etl_chatgpt_config",
        "//datalib/backend/etl/providers/contacts:datalib_etl_contacts",
        "//datalib/backend/etl/providers/email:datalib_etl_email",
        "//datalib/backend/etl/providers/email_config:datalib_etl_email_config",
        "//datalib/backend/etl/providers/fsindex:datalib_etl_fsindex",
        "//datalib/backend/etl/providers/fsindex_config:datalib_etl_fsindex_config",
        "//datalib/backend/etl/providers/lightroom:datalib_etl_lightroom",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "//datalib/backend/etl/providers/github:datalib_etl_github",
        "//datalib/backend/etl/providers/github_config:datalib_etl_github_config",
        "//datalib/backend/etl/providers/gitlab:datalib_etl_gitlab",
        "//datalib/backend/etl/providers/gitlab_config:datalib_etl_gitlab_config",
        "//datalib/backend/etl/providers/google_takeout:datalib_etl_google_takeout",
