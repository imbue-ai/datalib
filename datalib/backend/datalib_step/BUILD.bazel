rust_test(
    name = "datalib_step_unittests",
    size = "small",
    crate = ":datalib_step",
    # The checked-in example configs, which `config_examples_test.rs`
    # loads and plans through the real dispatcher so the docs can't drift
    # from the provider schemas.
    data = [
        "//configs:dag_example.toml",
        "//datalib/docker:demo/config.toml",
        "//docs/user/config_examples:all_sources.toml",
        "//docs/user/config_examples:claude_only.toml",
        "//docs/user/config_examples:sample_config.toml",
        # The UI's copy of the ingest-method declarations, which
        # `methods.rs` checks is generated from the config crates.
        "//datalib/ui:src/config/ingestMethods.json",
    ],
    edition = "2021",
    # Stub `DataProcessor`s for the render-version staleness tests.
    proc_macro_deps = ["@datalib_crates//:async-trait"],
    deps = [
        "@datalib_crates//:runfiles",
        "@datalib_crates//:tempfile",
    ],
)

# Regenerates datalib/ui/src/config/ingestMethods.json from the provider
# config crates' `IngestMethods` declarations.
insta_update(
    name = "ingest_methods.update",
    test = ":datalib_step_unittests",
    test_args = ["ui_mirror_matches_the_declarations"],
)
