load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//tools:insta.bzl", "insta_update")

# `datalib-step` — the built-in step program for the DAG runner
# (//datalib/backend/dag:datalib_dag_bin). Reads its function (ingest /
# render_markdown / grid_index / qmd_index) and its group's type from the
# environment the runner sets, and honors the DAG step contract (NDJSON
# events on stdout, final outcome line).
#
# Bazel-only: it links the provider crates, which have no cargo
# counterpart.
rust_binary(
    name = "datalib_step",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_step",
    crate_root = "src/main.rs",
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/dag:datalib_dag",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/etl/providers/claude:datalib_etl_claude",
        "//datalib/backend/etl/providers/claude_render:datalib_etl_claude_render",
        "//datalib/backend/etl/providers/claude_config:datalib_etl_claude_config",
        "//datalib/backend/etl/providers/beeper:datalib_etl_beeper",
        "//datalib/backend/etl/providers/beeper_render:datalib_etl_beeper_render",
        "//datalib/backend/etl/providers/beeper_config:datalib_etl_beeper_config",
        "//datalib/backend/etl/providers/carddav_config:datalib_etl_carddav_config",
        "//datalib/backend/etl/providers/chatgpt:datalib_etl_chatgpt",
