load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# What the agent-session sources' render crates (claude_code, codex)
# share: the paged read of the store and the pieces a transcript's items
# are built from. Render side: it knows chat-common's types.
rust_library(
    name = "datalib_etl_agent_sessions_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_agent_sessions_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "agent_sessions_render_unittests",
    size = "small",
    crate = ":datalib_etl_agent_sessions_render",
    edition = "2021",
)
