load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# A small, Lightroom-shaped catalog fixture for the engine's own tests.
# Generated rather than checked in, and generated by *Python* rather than
# by a Rust tool, because every Rust binary in this tree links doltlite as
# its `sqlite3`: doltlite reads and writes ordinary SQLite files
# transparently, but any file it creates is in doltlite's own prolly-tree
# format. Python's stdlib `sqlite3` is the only thing here that can mint
# a plain `.lrcat`: `libsqlite3-sys` is routed at doltlite for the whole
# workspace (see MODULE.bazel), so no Rust target in this tree can produce
# one either.
#
# The generator lives in //tests/fixtures rather than beside this crate
# because that is one of the repo's three PYTHON_LINT_ROOTS (see
# scripts/lint_repo.py), and because AGENTS.md scopes Python here to
# exactly this: fixture / test-pipeline tooling.
genrule(
    name = "tng_catalog",
    srcs = ["//tests/fixtures:make_lightroom_catalog.py"],
    outs = ["tng_catalog/TngCatalog.lrcat"],
    cmd = "python3 $(execpath //tests/fixtures:make_lightroom_catalog.py) $@",
    visibility = ["//datalib:__subpackages__"],
)

rust_library(
    name = "datalib_etl_sqlite_mirror",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_sqlite_mirror",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/source_common:datalib_source_common",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tracing",
    ],
)

# Inline `#[cfg(test)]` unit tests in the library sources (plan.rs's DDL
# synthesis, mirror.rs's key selection and column filtering). Without
# this `crate = ":..."` target they are silently never executed — see the
# note in fsindex's BUILD.bazel.
rust_test(
    name = "sqlite_mirror_unittests",
    size = "small",
    crate = ":datalib_etl_sqlite_mirror",
    edition = "2021",
)

# The end-to-end contract: mirror, re-mirror an unchanged database (no
# commit), then insert / update / delete in the source and assert both
# the mirrored state and the `dolt_diff_` classification, plus that
# `dolt_history_` still holds the superseded values.
rust_test(
    name = "mirror_roundtrip",
    size = "small",
    srcs = ["tests/mirror_roundtrip.rs"],
    crate_name = "mirror_roundtrip",
    data = [":tng_catalog"],
    edition = "2021",
    env = {
        "SQLITE_MIRROR_TNG_CATALOG": "$(rootpath :tng_catalog)",
    },
    deps = [
        ":datalib_etl_sqlite_mirror",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
