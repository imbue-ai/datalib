load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Framework crate. Provider-specific Extract/Translate code lives in
# sibling crates under providers/<name>/ (see providers/slack/BUILD.bazel).
rust_library(
    name = "datalib_etl",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    # The dispatch curl + the impersonator it fronts travel with the
    # library so any binary that links `datalib_etl` gets both in
    # runfiles (co-located, so the dispatch curl finds the impersonator as
    # a sibling); `latchkey::ensure_curl_dispatch` resolves the dispatch curl
    # via the bazel runfiles lookup in `resolve()`.
    data = [
        ":latchkey_curl_dispatch",
        ":latchkey_curl_impersonate",
    ],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/time:datalib_time",
        "//datalib/backend/table:datalib_table",
        "//datalib/backend/source_common:datalib_source_common",

        "@datalib_crates//:anyhow",
        "@datalib_crates//:blake3",
        "@datalib_crates//:chrono",
        "@datalib_crates//:ignore",
        "@datalib_crates//:indicatif",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",    ],
)

# The Chrome-impersonating curl: upstream `curl-impersonate`, built from
# source by our own workflow and fetched by MODULE.bazel (see
# //third-party/curl-impersonate). Copied here, under this name, because
# that is where everything looks for it: `latchkey_curl_dispatch` finds
# it as a sibling of itself, every provider test gets it as a runfile of
# `datalib_etl`, and release.yml stages `bazel-bin/datalib/backend/etl/
# latchkey_curl_impersonate` as `latchkey-curl-impersonate`. It is not
# `curl` on its own: without `--impersonate` it presents a stock curl
# fingerprint, and the dispatch is what adds that flag.
copy_file(
    name = "latchkey_curl_impersonate",
    src = "//third-party/curl-impersonate:curl_impersonate",
    out = "latchkey_curl_impersonate",
    is_executable = True,
    visibility = ["//datalib:__subpackages__"],
)

# Drop-in `curl` that routes on the `X-Imbue-Impersonate` marker header:
# marked requests go to the impersonating binary above (found as a
# sibling of this one, and given the flags that make it impersonate),
# all others pass through to `curl` on PATH. std-only — no deps.
rust_binary(
    name = "latchkey_curl_dispatch",
    srcs = ["src/bin/latchkey_curl_dispatch.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
)

rust_test(
    name = "latchkey_curl_dispatch_test",
    size = "small",
    crate = ":latchkey_curl_dispatch",
    edition = "2021",
)

# The exec half of the dispatch, which the unit tests above cannot
# reach: copies the binary next to fake `latchkey-curl-impersonate` and
# `curl` scripts and checks which one each kind of invocation lands on,
# with what argv.
sh_test(
    name = "latchkey_curl_dispatch_exec_test",
    size = "small",
    srcs = ["tests/latchkey_curl_dispatch_exec_test.sh"],
    args = ["$(rootpath :latchkey_curl_dispatch)"],
    data = [":latchkey_curl_dispatch"],
)


rust_test(
    name = "etl_unittests",
    size = "small",
    crate = ":datalib_etl",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# One side of the two-process doltlite concurrency test below: a writer, a
# pinned reader, or a probe. It is a binary rather than a second pool inside
# the test because doltlite's working set and chunk-store lock are per *file*
# and shared across processes — two pools in one process do not exercise them.
# `testonly` and under `tests/`: nothing shipped may link it, and cargo does
# not pick it up as a bin of this crate.
rust_binary(
    name = "doltlite_two_process",
    testonly = True,
    srcs = ["tests/bin/doltlite_two_process.rs"],
    edition = "2021",
    deps = [
        ":datalib_etl",
        "//datalib/backend/history:datalib_history",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)

# Can a reader pin an earlier commit while another process holds the store
# open and commits — in both orders of opening? Hermetic: the store is a
# tempdir, and the only program it runs is the helper above, from runfiles.
rust_test(
    name = "doltlite_two_process_test",
    size = "medium",
    srcs = ["tests/doltlite_two_process.rs"],
    data = [":doltlite_two_process"],
    edition = "2021",
    env = {
        "HELPER_BIN": "$(rootpath :doltlite_two_process)",
    },
    deps = [
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
    ],
)
