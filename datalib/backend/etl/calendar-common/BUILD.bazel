load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "datalib_etl_calendar_common",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_calendar_common",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:chrono-tz",
    ],
)

rust_test(
    name = "calendar_common_unittests",
    size = "small",
    crate = ":datalib_etl_calendar_common",
    edition = "2021",
    deps = ["@datalib_crates//:tempfile"],
)
