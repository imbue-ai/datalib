load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# Checked-in JSON fixtures used by render + playback tests.
filegroup(
    name = "fixtures",
    srcs = glob(
        ["tests/fixtures/**/*"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Subset of `fixtures` consumed by //tests/fixtures:ingested_tng — the
# Star Trek themed Google Takeout mbox that drives the email extract
# path end-to-end (mbox → raw → translate → render).
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/mbox/*.mbox"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_email",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_email",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/email_config:datalib_etl_email_config",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:mail-parser",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Extract step — JMAP session, state-token-incremental sync of mailboxes,
# emails, threads, attachments + .eml bytes into one .doltlite_db.
rust_binary(
    name = "jmap_ingest",
    srcs = ["src/bin/jmap_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_email",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "jmap_unittests",
    size = "small",
    crate = ":datalib_etl_email",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# Every hermetic email test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "email_tests",
    srcs = glob(["tests/email_tests/*.rs"]),
    crate_root = "tests/email_tests/main.rs",
    data = glob(["tests/email_tests/snapshots/*.snap"], allow_empty = True) + [
        ":fixtures",
    ],
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
        "JMAP_FIXTURE_DIR": "datalib/backend/etl/providers/email/tests/fixtures",
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        "//datalib/backend/etl/providers/email_render:datalib_etl_email_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        ":datalib_etl_email",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# Live test — talks to api.fastmail.com via latchkey. Manual.
# Live Gmail REST API test: mirrors one label out of a real account and
# asserts against the doltlite store it wrote. Needs a `google-gmail`
# credential in the host's latchkey (hence no-sandbox) and talks to
# Google (hence external).
rust_test(
    name = "gmail_live",
    srcs = ["tests/gmail_live.rs"],
    crate_root = "tests/gmail_live.rs",
    edition = "2021",
    tags = [
        "external",  # talks to gmail.googleapis.com
        "manual",
        "no-remote-exec",
        "no-sandbox",  # latchkey reads the host keyring
    ],
    deps = [
        ":datalib_etl_email",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "email_tests.update",
    test = ":email_tests",
)

# `manual` keeps these out of `//...`, so nothing else ever builds them.
# See scripts/lint_repo.py check 7.
build_test(
    name = "manual_targets_build",
    targets = [
        ":gmail_live",
    ],
)
