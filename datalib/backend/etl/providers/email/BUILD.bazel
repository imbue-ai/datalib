load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")
load("//tools:live.bzl", "live_run")

# Checked-in JSON fixtures used by render + playback tests.
filegroup(
    name = "fixtures",
    srcs = glob(
        ["tests/fixtures/**/*"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

# Subset of `fixtures` consumed by //tests/fixtures:ingested_tng — the
# Star Trek themed Google Takeout mbox that drives the email extract
# path end-to-end (mbox → raw → translate → render).
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/mbox/*.mbox"]),
    visibility = ["//visibility:public"],
)

# A small Mail folder with a Gmail account and a Fastmail one, minted by
# Python so its Envelope Index is plain SQLite written by a stock engine
# (tests/fixtures/make_apple_mail_folder.py says what is in it). A tar,
# since Mail's paths are not paths a Bazel output may have.
genrule(
    name = "tng_apple_mail",
    srcs = ["//tests/fixtures:make_apple_mail_folder.py"],
    outs = ["tng_apple_mail.tar"],
    cmd = "python3 $(execpath //tests/fixtures:make_apple_mail_folder.py) $@",
)

rust_library(
    name = "datalib_etl_email",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_email",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/files:datalib_etl_files",
        "//datalib/backend/etl/sqlite_mirror:datalib_etl_sqlite_mirror",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/etl/providers/email_config:datalib_etl_email_config",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:base64",
        "@datalib_crates//:chrono",
        "@datalib_crates//:mail-parser",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:urlencoding",
    ],
)

rust_test(
    name = "jmap_unittests",
    size = "small",
    crate = ":datalib_etl_email",
    edition = "2021",
    deps = [
        "@datalib_crates//:flate2",
        "@datalib_crates//:tar",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:zip",
    ],
)

# Every hermetic email test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "email_tests",
    srcs = glob(["tests/email_tests/*.rs"]),
    args = ["--skip", "live::"],
    crate_root = "tests/email_tests/main.rs",
    data = glob(["tests/email_tests/snapshots/*.snap"], allow_empty = True) + [
        ":fixtures",
        ":tng_apple_mail",
        "//datalib/backend/datalib_step",
    ],
    edition = "2021",
    env = {
        "APPLE_MAIL_TNG_TAR": "$(rootpath :tng_apple_mail)",
        "DATALIB_STEP_BIN": "$(rootpath //datalib/backend/datalib_step)",
        "INSTA_WORKSPACE_ROOT": ".",
        "JMAP_FIXTURE_DIR": "datalib/backend/etl/providers/email/tests/fixtures",
    },
    proc_macro_deps = ["@datalib_crates//:async-trait"],
    deps = [
        "//datalib/backend/blob_store:datalib_blob_store",
        "//datalib/backend/etl/providers/email_render:datalib_etl_email_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/files:datalib_etl_files",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/time:datalib_time",
        ":datalib_etl_email",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:mail-parser",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tar",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:zip",
    ],
)

insta_update(
    name = "email_tests.update",
    test = ":email_tests",
    test_args = ["--skip", "live::"],
)

# The live tests of `email_tests`'s `live` module — the ones its
# `--skip live::` leaves out. `bazel run`, so they inherit the
# shell's `LATCHKEY_CURL` and reach the host keyring.
live_run(
    name = "gmail_live",
    extra_data = ["//datalib/backend/datalib_step"],
    extra_env = {"DATALIB_STEP_BIN": "$(rootpath //datalib/backend/datalib_step)"},
    test = ":email_tests",
)
