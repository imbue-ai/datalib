load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")
load("//tools:live.bzl", "live_run")

# The checked-in TNG playback fixture, an input of the Python
# fixture-build pipeline at //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/github_api/**/*.jsonl"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_github",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_github",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl/forge-ingest-common:datalib_etl_forge_ingest_common",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/etl/providers/github_config:datalib_etl_github_config",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:urlencoding",
    ],
)

rust_binary(
    name = "github_ingest",
    srcs = ["src/bin/github_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_github",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "github_unittests",
    size = "small",
    crate = ":datalib_etl_github",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# Every hermetic GitHub test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "github_tests",
    srcs = glob(["tests/github_tests/*.rs"]),
    args = ["--skip", "live::"],
    crate_root = "tests/github_tests/main.rs",
    data = glob(["tests/github_tests/snapshots/*.snap"], allow_empty = True),
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
    },
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/forge-ingest-common:datalib_etl_forge_ingest_common",
        "//datalib/backend/etl/providers/github_render:datalib_etl_github_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/web:datalib_etl_web",
        ":datalib_etl_github",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "github_live.update",
    test = ":github_tests",
    test_args = ["live::"],
)

# The live tests of `github_tests`'s `live` module — the ones its
# `--skip live::` leaves out. `bazel run`, so they inherit the
# shell's `LATCHKEY_CURL` and reach the host keyring.
live_run(
    name = "github_live",
    test = ":github_tests",
)
