load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Schema-only config crate for the `email` source.
# Depends on serde + anyhow only — no extraction code — so the orchestrator
# and the `http` backend can name `EmailConfig` without linking the provider.
#
# Bazel-only by design (no Cargo.toml): a first-party crate that uses only
# already-vendored third-party deps needs just this BUILD file. See
# AGENTS.md, "Why each provider has a <p>_config crate".
rust_library(
    name = "datalib_etl_email_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_email_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/source_common:datalib_source_common",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
    ],
)

rust_test(
    name = "email_config_unittests",
    size = "small",
    crate = ":datalib_etl_email_config",
    edition = "2021",
    # Tests only: the round-trip cases parse a `--params` payload the way
    # the step planner does, which is JSON.
    deps = ["@datalib_crates//:serde_json"],
)
