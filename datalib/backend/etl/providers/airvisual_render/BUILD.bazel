load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `airvisual` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/airvisual is the
# ingest half and deliberately does not.
rust_library(
    name = "datalib_etl_airvisual_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_airvisual_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/providers/airvisual:datalib_etl_airvisual",
        "//datalib/backend/etl/providers/airvisual_config:datalib_etl_airvisual_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl/timeseries_render:datalib_etl_timeseries_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "airvisual_render_unittests",
    size = "small",
    crate = ":datalib_etl_airvisual_render",
    edition = "2021",
)
