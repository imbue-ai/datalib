load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# The TNG account, expanded into playback fixtures by the synthesizer.
# Consumed by `//tests/fixtures:ingested_tng`.
filegroup(
    name = "tng_fixture",
    srcs = ["tests/fixtures/garmin_tng/tng.json"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_garmin",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_garmin",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/etl/providers/garmin_config:datalib_etl_garmin_config",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tracing",
        "@datalib_crates//:urlencoding",
        "@datalib_crates//:zip",
    ],
)

rust_test(
    name = "garmin_unittests",
    size = "small",
    crate = ":datalib_etl_garmin",
    edition = "2021",
)

# Every hermetic Garmin test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "garmin_tests",
    srcs = glob(["tests/garmin_tests/*.rs"]),
    crate_root = "tests/garmin_tests/main.rs",
    data = [
        ":tng_fixture",
    ],
    edition = "2021",
    env = {
        "RUST_TEST_THREADS": "1",
    },
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "@datalib_crates//:anyhow",
        "//datalib/backend/etl/providers/garmin_config:datalib_etl_garmin_config",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/pin:datalib_pin",
        ":datalib_etl_garmin",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

