load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The `chatgpt` source's config schema alone, so anything that reads a
# config can link it without the download. Bazel-only.
rust_library(
    name = "datalib_etl_chatgpt_config",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["examples/*.toml"]),
    crate_name = "datalib_etl_chatgpt_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/source_common:datalib_source_common",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:schemars",
        "@datalib_crates//:serde",
    ],
)

rust_test(
    name = "chatgpt_config_unittests",
    size = "small",
    crate = ":datalib_etl_chatgpt_config",
    edition = "2021",
    deps = ["@datalib_crates//:toml"],
)
