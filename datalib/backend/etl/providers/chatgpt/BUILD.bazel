load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# Filegroup for the checked-in TNG-themed fixture used by both Rust
# integration tests here and the Python fixture-build pipeline at
# //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/chatgpt_api/**/*.json"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_chatgpt",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_chatgpt",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/chatgpt_config:datalib_etl_chatgpt_config",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_binary(
    name = "chatgpt_ingest",
    srcs = ["src/bin/chatgpt_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_chatgpt",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Every hermetic ChatGPT test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "chatgpt_tests",
    srcs = glob(["tests/chatgpt_tests/*.rs"]),
    crate_root = "tests/chatgpt_tests/main.rs",
    data = glob(["tests/chatgpt_tests/snapshots/*.snap"], allow_empty = True) + [
        ":tng_fixture",
    ],
    edition = "2021",
    env = {
        "CHATGPT_FIXTURE_DIR": "datalib/backend/etl/providers/chatgpt/tests/fixtures/chatgpt_api",
        "INSTA_WORKSPACE_ROOT": ".",
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        "//datalib/backend/etl/providers/chatgpt_render:datalib_etl_chatgpt_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        ":datalib_etl_chatgpt",
        "@datalib_crates//:chrono",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)


rust_test(
    name = "chatgpt_unittests",
    size = "small",
    crate = ":datalib_etl_chatgpt",
    data = [":tng_fixture"],
    edition = "2021",
    env = {
        "CHATGPT_FIXTURE_DIR": "datalib/backend/etl/providers/chatgpt/tests/fixtures/chatgpt_api",
    },
)


# Downloads one real conversation through latchkey and snapshots it;
# `#[ignore]`d and manual because it talks to chatgpt.com. Run it with
# `bazelisk run //datalib/backend/etl/providers/chatgpt:chatgpt_live.update`.
rust_test(
    name = "chatgpt_live",
    srcs = ["tests/chatgpt_live.rs"],
    crate_root = "tests/chatgpt_live.rs",
    data = glob(["tests/snapshots/chatgpt_live__*.snap"], allow_empty = True),
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
    },
    tags = [
        "external",  # talks to chatgpt.com
        "manual",
        "no-remote-exec",
        "no-sandbox",  # latchkey reads keyring + LATCHKEY_CURL from host
    ],
    deps = [
        ":datalib_etl_chatgpt",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)


# `bazel run //...:foo.update` siblings that re-run the insta-using
# test with INSTA_UPDATE=always and write back into the source tree.
insta_update(
    name = "chatgpt_tests.update",
    test = ":chatgpt_tests",
    extra_data = [":tng_fixture"],
    extra_env = {
        "CHATGPT_FIXTURE_DIR": "datalib/backend/etl/providers/chatgpt/tests/fixtures/chatgpt_api",
    },
)

insta_update(
    name = "chatgpt_live.update",
    test = ":chatgpt_live",
    test_args = ["--ignored"],
)

# `manual` keeps these out of `//...`, so nothing else ever builds them.
# See scripts/lint_repo.py check 7.
build_test(
    name = "manual_targets_build",
    targets = [
        ":chatgpt_live",
    ],
)
