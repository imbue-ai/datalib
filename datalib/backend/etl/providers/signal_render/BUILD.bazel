load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `signal` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/signal is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_signal_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_signal_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/providers/signal:datalib_etl_signal",
        "//datalib/backend/etl/providers/signal_config:datalib_etl_signal_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/signal-backup:datalib_signal_backup",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "signal_render_unittests",
    size = "small",
    crate = ":datalib_etl_signal_render",
    edition = "2021",
)
