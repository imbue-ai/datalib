load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `notion` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/notion is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_notion_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_notion_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/providers/notion:datalib_etl_notion",
        "//datalib/backend/etl/providers/notion_config:datalib_etl_notion_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:once_cell",
        "@datalib_crates//:regex",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "notion_render_unittests",
    size = "small",
    crate = ":datalib_etl_notion_render",
    edition = "2021",
    deps = [
        "@datalib_crates//:tokio",
        "@datalib_crates//:tempfile",
        # Used by `gather_documents_is_linear_in_blocks` to flush the
        # per-phase `tracing::debug!` events from `gather_documents`
        # to stderr — see the test's `init_tracing()` helper.
    ],
)
