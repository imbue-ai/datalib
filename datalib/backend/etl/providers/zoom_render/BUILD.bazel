load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Render half of the `zoom` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/zoom is the download
# half and deliberately does not.
rust_library(
    name = "datalib_etl_zoom_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_zoom_render",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/providers/zoom:datalib_etl_zoom",
        "//datalib/backend/etl/providers/zoom_config:datalib_etl_zoom_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/handle:datalib_handle",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "zoom_render_unittests",
    size = "small",
    crate = ":datalib_etl_zoom_render",
    edition = "2021",
)

rust_test(
    name = "render_store_test",
    size = "small",
    srcs = ["tests/render_store.rs"],
    edition = "2021",
    deps = [
        ":datalib_etl_zoom_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/zoom:datalib_etl_zoom",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
