load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Render half of the `calendar` provider: the side that knows
# `datalib_schema`. //datalib/backend/etl/providers/calendar is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_calendar_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_calendar_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/calendar-common:datalib_etl_calendar_common",
        "//datalib/backend/etl/providers/calendar:datalib_etl_calendar",
        "//datalib/backend/etl/providers/calendar_config:datalib_etl_calendar_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "calendar_render_unittests",
    size = "small",
    crate = ":datalib_etl_calendar_render",
    edition = "2021",
    data = ["//datalib/backend/etl/providers/calendar:tng_fixture"],
)
