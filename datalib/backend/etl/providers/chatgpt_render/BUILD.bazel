load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `chatgpt` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/chatgpt is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_chatgpt_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_chatgpt_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/providers/chatgpt:datalib_etl_chatgpt",
        "//datalib/backend/etl/providers/chatgpt_config:datalib_etl_chatgpt_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "chatgpt_render_unittests",
    size = "small",
    crate = ":datalib_etl_chatgpt_render",
    edition = "2021",
)
