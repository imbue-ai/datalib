load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `google_takeout` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/google_takeout is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_google_takeout_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_google_takeout_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/providers/google_takeout:datalib_etl_google_takeout",
        "//datalib/backend/etl/providers/google_takeout_config:datalib_etl_google_takeout_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tokio",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "google_takeout_render_unittests",
    size = "small",
    crate = ":datalib_etl_google_takeout_render",
    edition = "2021",
    deps = [
    ],
)
