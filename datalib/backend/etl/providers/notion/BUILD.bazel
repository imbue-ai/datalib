load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")
load("//tools:live.bzl", "live_run")

exports_files(["Cargo.toml"])

# The checked-in TNG playback fixture, an input of the Python
# fixture-build pipeline at //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/notion_web/**/*.jsonl"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_notion",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_notion",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/notion_config:datalib_etl_notion_config",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_binary(
    name = "notion_ingest",
    srcs = ["src/bin/notion_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_notion",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "notion_unittests",
    size = "small",
    crate = ":datalib_etl_notion",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
        # Used by `gather_documents_is_linear_in_blocks` to flush the
        # per-phase `tracing::debug!` events from `gather_documents`
        # to stderr — see the test's `init_tracing()` helper.
    ],
)

# Every hermetic Notion test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "notion_tests",
    srcs = glob(["tests/notion_tests/*.rs"]),
    args = ["--skip", "live::"],
    crate_root = "tests/notion_tests/main.rs",
    data = glob(["tests/notion_tests/snapshots/*.snap"], allow_empty = True),
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        "//datalib/backend/etl/providers/notion_render:datalib_etl_notion_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        ":datalib_etl_notion",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "notion_live.update",
    test = ":notion_tests",
    test_args = ["live::"],
)

# The live tests of `notion_tests`'s `live` module — the ones its
# `--skip live::` leaves out. `bazel run`, so they inherit the
# shell's `LATCHKEY_CURL` and reach the host keyring.
live_run(
    name = "notion_live",
    test = ":notion_tests",
)
