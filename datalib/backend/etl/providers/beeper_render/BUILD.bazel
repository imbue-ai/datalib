load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Render half of the `beeper` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/beeper is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_beeper_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_beeper_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/contact_schema:datalib_contact_schema",
        "//datalib/backend/handle:datalib_handle",
        "//datalib/backend/etl/providers/beeper_config:datalib_etl_beeper_config",
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "beeper_render_unittests",
    size = "small",
    crate = ":datalib_etl_beeper_render",
    edition = "2021",
)

# The TNG fixture mirrored into doltlite the way the ingest step does it,
# then rendered.
rust_test(
    name = "beeper_roundtrip",
    size = "small",
    srcs = ["tests/beeper_roundtrip.rs"],
    crate_name = "beeper_roundtrip",
    data = [
        "//datalib/backend/etl/providers/beeper:tng_beeper_texts",
        "//datalib/backend/etl/providers/beeper:tng_beeper_texts/index.db",
    ],
    edition = "2021",
    env = {
        "BEEPER_TNG_INDEX_DB": "$(rootpath //datalib/backend/etl/providers/beeper:tng_beeper_texts/index.db)",
    },
    deps = [
        ":datalib_etl_beeper_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/beeper:datalib_etl_beeper",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl/sqlite_mirror:datalib_etl_sqlite_mirror",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
