load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Checked-in TNG-themed fixture spec consumed by the unified
# //tests/fixtures:ingested_tng genrule. Just a single JSON file
# describing the Bridge Crew chat — `run_sync_pipeline.py` runs
# `signal_make_fixture` against it at genrule-time to materialize the
# encrypted snapshot dir before invoking the extractor.
filegroup(
    name = "tng_fixture",
    srcs = ["tests/fixtures/signal_tng/tng.json"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_signal",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_signal",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/signal_config:datalib_etl_signal_config",
        "//datalib/backend/index_lib:datalib_index_lib",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/signal-backup:datalib_signal_backup",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:blake3",
        "@datalib_crates//:chrono",
        "@datalib_crates//:prost",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "signal_etl_unittests",
    size = "small",
    crate = ":datalib_etl_signal",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# End-to-end against an inline TNG snapshot built via the
# library writer. No external data deps — the test materializes
# the encrypted snapshot itself, then drives download + render
# against it, then asserts on rendered markdown content.
rust_test(
    name = "signal_tng_e2e",
    srcs = ["tests/signal_tng_e2e.rs"],
    crate_root = "tests/signal_tng_e2e.rs",
    edition = "2021",
    deps = [
        ":datalib_etl_signal",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/signal-backup:datalib_signal_backup",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
