load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# Two TNG-themed Pros' data folders, in the share's own layout: an
# archive per clock change, a pre-clock file, a corrupt/restored pair,
# a live month ending in NULs. Used by :airvisual_fixture_e2e and the
# central fixture pipeline at //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/airvisual_tng/**/*"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_airvisual",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_airvisual",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/airvisual_config:datalib_etl_airvisual_config",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tracing",
    ],
)

# Unit tests with insta snapshots; see yolink's BUILD for why
# INSTA_WORKSPACE_ROOT is set.
rust_test(
    name = "airvisual_unittests",
    size = "small",
    crate = ":datalib_etl_airvisual",
    data = glob(["src/ingest/snapshots/*.snap"], allow_empty = True),
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
    },
    deps = [
        "@datalib_crates//:insta",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "airvisual_unittests.update",
    test = ":airvisual_unittests",
)

# Every hermetic AirVisual test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "airvisual_tests",
    srcs = glob(["tests/airvisual_tests/*.rs"]),
    crate_root = "tests/airvisual_tests/main.rs",
    data = [
        ":tng_fixture",
    ],
    edition = "2021",
    env = {
        "AIRVISUAL_FIXTURE_DIR": "datalib/backend/etl/providers/airvisual/tests/fixtures/airvisual_tng",
    },
    deps = [
        "//datalib/backend/etl/providers/airvisual_config:datalib_etl_airvisual_config",
        "//datalib/backend/etl/providers/airvisual_render:datalib_etl_airvisual_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        ":datalib_etl_airvisual",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

