load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `codex` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/codex is the ingest
# half and deliberately does not.
rust_library(
    name = "datalib_etl_codex_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_codex_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/providers/codex:datalib_etl_codex",
        "//datalib/backend/etl/providers/codex_config:datalib_etl_codex_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "codex_render_unittests",
    size = "small",
    crate = ":datalib_etl_codex_render",
    edition = "2021",
)
