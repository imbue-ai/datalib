load("@rules_rust//rust:defs.bzl", "rust_library")

# Schema-only config crate for codex.
# Bazel-only by design (no Cargo.toml). See
# AGENTS.md §"Repo layout" (why each provider has a <p>_config crate).
rust_library(
    name = "datalib_etl_codex_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_codex_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl/agent_sessions_config:datalib_etl_agent_sessions_config",
    ],
)
