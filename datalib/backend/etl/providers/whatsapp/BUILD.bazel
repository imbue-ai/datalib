load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Checked-in TNG-themed fixture spec consumed by the unified
# //tests/fixtures:ingested_tng genrule. Mirror of the signal pattern:
# run_sync_pipeline.py runs `whatsapp_make_fixture` against this spec
# at genrule-time to materialize an encrypted backup dir before
# invoking the extractor.
filegroup(
    name = "tng_fixture",
    srcs = ["tests/fixtures/whatsapp_tng/tng.json"],
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_whatsapp",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_whatsapp",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/providers/whatsapp_config:datalib_etl_whatsapp_config",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "//datalib/backend/whatsapp-backup:datalib_whatsapp_backup",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:uuid",
        "@datalib_crates//:walkdir",
    ],
)

rust_binary(
    name = "whatsapp_make_fixture",
    srcs = ["src/bin/whatsapp_make_fixture.rs"],
    edition = "2021",
    # Consumed by //tests/fixtures:ingested_tng outside the //datalib
    # tree; mirrors signal_make_fixture's visibility.
    visibility = ["//visibility:public"],
    deps = [
        ":datalib_etl_whatsapp",
        "//datalib/backend/whatsapp-backup:datalib_whatsapp_backup",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "whatsapp_etl_unittests",
    size = "small",
    crate = ":datalib_etl_whatsapp",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)
