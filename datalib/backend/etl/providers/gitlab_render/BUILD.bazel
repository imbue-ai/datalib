load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `gitlab` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/gitlab is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_gitlab_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_gitlab_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/providers/gitlab:datalib_etl_gitlab",
        "//datalib/backend/etl/providers/gitlab_config:datalib_etl_gitlab_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:clap",
        "@datalib_crates//:once_cell",
        "@datalib_crates//:regex",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:urlencoding",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "gitlab_render_unittests",
    size = "small",
    crate = ":datalib_etl_gitlab_render",
    edition = "2021",
)
