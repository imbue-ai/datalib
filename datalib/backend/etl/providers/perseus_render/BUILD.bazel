load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `perseus` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/perseus is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_perseus_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_perseus_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/providers/perseus:datalib_etl_perseus",
        "//datalib/backend/etl/providers/perseus_config:datalib_etl_perseus_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:candle-core",
        "@datalib_crates//:candle-nn",
        "@datalib_crates//:candle-transformers",
        "@datalib_crates//:chrono",
        "@datalib_crates//:hf-hub",
        "@datalib_crates//:quick-xml",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tokenizers",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:uuid",
        # Sentence-level alignment via Ancient-Greek-BERT runs through
        # candle-transformers; weights are pulled lazily by hf-hub and
        # tokenized by `tokenizers`. See `src/translate/align/embed.rs`.
    ],
)

rust_test(
    name = "perseus_render_unittests",
    size = "small",
    crate = ":datalib_etl_perseus_render",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)
