load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `contacts` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/contacts is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_contacts_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_contacts_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/contact-common:datalib_etl_contact_common",
        "//datalib/backend/etl/providers/contacts_config:datalib_etl_contacts_config",
        "//datalib/backend/etl/providers/contacts:datalib_etl_contacts",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:base64",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "contacts_render_unittests",
    size = "small",
    crate = ":datalib_etl_contacts_render",
    edition = "2021",
    deps = [
    ],
)
