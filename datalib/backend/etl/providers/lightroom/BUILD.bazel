load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "datalib_etl_lightroom",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_lightroom",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "//datalib/backend/etl/sqlite_mirror:datalib_etl_sqlite_mirror",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
    ],
)

rust_binary(
    name = "lightroom_ingest",
    srcs = ["src/bin/lightroom_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_lightroom",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Four real Lightroom catalogs from github.com/thadd3us/lightroom_db_diff,
# fetched by Bazel (see the `http_file` block in MODULE.bazel) rather than
# vendored: ~7 MB of binary that would otherwise sit in this repo's
# history forever. Bazel's repository cache makes the download one-time
# per machine per pin, which is why this can be an ordinary test target
# and not a manual script.
#
# `requires-network`: hermetic and cached once fetched, but a cold cache
# has to reach github.com.
#
# `medium` (300s), not `small` (60s): headroom for a loaded CI runner.
# The body takes 6-13s on a dev machine, and the catalog download is an
# `http_file` repository rule that runs at fetch time and so never counts
# against this timeout — but it still hit 60.2s and TIMEOUT on #178, then
# passed on a re-run of the same commit. What is special about CI is
# contention: this test only runs there when something invalidates
# `datalib_etl` (otherwise it is a cache hit), which is precisely the run
# where the whole suite is rebuilding around it.
#
# Bazel will now warn that 6.5s is "outside of range for MODERATE tests"
# on every warm run. That heuristic reads the warm path, which is the one
# path that was never the problem. The warning is advisory and does not
# fail the build; several other targets already trigger it.
rust_test(
    name = "real_catalogs",
    size = "medium",
    srcs = ["tests/real_catalogs.rs"],
    crate_name = "real_catalogs",
    data = [
        "@lightroom_test_catalog_00//file",
        "@lightroom_test_catalog_01//file",
        "@lightroom_test_catalog_02//file",
        "@lightroom_test_catalog_03//file",
    ],
    edition = "2021",
    env = {
        "LIGHTROOM_CATALOG_00": "$(rootpath @lightroom_test_catalog_00//file)",
        "LIGHTROOM_CATALOG_01": "$(rootpath @lightroom_test_catalog_01//file)",
        "LIGHTROOM_CATALOG_02": "$(rootpath @lightroom_test_catalog_02//file)",
        "LIGHTROOM_CATALOG_03": "$(rootpath @lightroom_test_catalog_03//file)",
    },
    tags = [
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        ":datalib_etl_lightroom",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
