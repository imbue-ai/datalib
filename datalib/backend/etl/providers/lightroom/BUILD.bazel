load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# A small, Lightroom-shaped catalog fixture. Generated rather than
# checked in, and generated by *Python* rather than by a Rust tool,
# because every Rust binary in this tree links doltlite as its `sqlite3`:
# doltlite reads and writes ordinary SQLite files transparently, but any
# file it creates is in doltlite's own prolly-tree format. Python's
# stdlib `sqlite3` is the only thing here that can mint a plain `.lrcat`.
# See tests/make_catalog_fixture.py.
genrule(
    name = "tng_catalog",
    srcs = ["tests/make_catalog_fixture.py"],
    outs = ["tng_catalog/TngCatalog.lrcat"],
    cmd = "python3 $(execpath tests/make_catalog_fixture.py) $@",
    visibility = ["//datalib:__subpackages__"],
)

rust_library(
    name = "datalib_etl_lightroom",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_lightroom",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_binary(
    name = "lightroom_ingest",
    srcs = ["src/bin/lightroom_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_lightroom",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Inline `#[cfg(test)]` unit tests in the library sources (plan.rs's DDL
# synthesis and drift classification, mirror.rs's key selection and
# column filtering). Without this `crate = ":..."` target they are
# silently never executed — see the note in fsindex's BUILD.bazel.
rust_test(
    name = "lightroom_unittests",
    size = "small",
    crate = ":datalib_etl_lightroom",
    edition = "2021",
)

# The end-to-end contract: ingest, re-ingest an unchanged catalog (no
# commit), then insert / update / delete in the catalog and assert both
# the mirrored state and the `dolt_diff_` classification, plus that
# `dolt_history_` still holds the superseded values.
rust_test(
    name = "mirror_roundtrip",
    size = "small",
    srcs = ["tests/mirror_roundtrip.rs"],
    crate_name = "mirror_roundtrip",
    data = [":tng_catalog"],
    edition = "2021",
    env = {
        "LIGHTROOM_TNG_CATALOG": "$(rootpath :tng_catalog)",
    },
    deps = [
        ":datalib_etl_lightroom",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/lightroom_config:datalib_etl_lightroom_config",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# Four real Lightroom catalogs from github.com/thadd3us/lightroom_db_diff,
# fetched by Bazel (see the `http_file` block in MODULE.bazel) rather than
# vendored: ~7 MB of binary that would otherwise sit in this repo's
# history forever. Bazel's repository cache makes the download one-time
# per machine per pin, which is why this can be an ordinary test target
# and not a manual script.
#
# `requires-network`: hermetic and cached once fetched, but a cold cache
# has to reach github.com.
rust_test(
    name = "real_catalogs",
    size = "small",
    srcs = ["tests/real_catalogs.rs"],
    crate_name = "real_catalogs",
    data = [
        "@lightroom_test_catalog_00//file",
        "@lightroom_test_catalog_01//file",
        "@lightroom_test_catalog_02//file",
        "@lightroom_test_catalog_03//file",
    ],
    edition = "2021",
    env = {
        "LIGHTROOM_CATALOG_00": "$(rootpath @lightroom_test_catalog_00//file)",
        "LIGHTROOM_CATALOG_01": "$(rootpath @lightroom_test_catalog_01//file)",
        "LIGHTROOM_CATALOG_02": "$(rootpath @lightroom_test_catalog_02//file)",
        "LIGHTROOM_CATALOG_03": "$(rootpath @lightroom_test_catalog_03//file)",
    },
    tags = ["requires-network"],
    deps = [
        ":datalib_etl_lightroom",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
