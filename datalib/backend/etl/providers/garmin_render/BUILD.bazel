load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `garmin` provider: the side that knows
# `datalib_schema`. //datalib/backend/etl/providers/garmin is the ingest
# half and deliberately does not.
rust_library(
    name = "datalib_etl_garmin_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_garmin_render",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/garmin:datalib_etl_garmin",
        "//datalib/backend/etl/providers/garmin_config:datalib_etl_garmin_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:once_cell",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "garmin_render_unittests",
    size = "small",
    crate = ":datalib_etl_garmin_render",
    edition = "2021",
)

# Ingest the TNG fixture through playback, then render: the page, its
# plot and its grid rows, and the HEAD-unchanged skip on a second pass.
rust_test(
    name = "garmin_render_e2e",
    size = "medium",
    srcs = ["tests/render_e2e.rs"],
    data = ["//datalib/backend/etl/providers/garmin:tng_fixture"],
    edition = "2021",
    deps = [
        ":datalib_etl_garmin_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/garmin:datalib_etl_garmin",
        "//datalib/backend/etl/providers/garmin_config:datalib_etl_garmin_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "@datalib_crates//:chrono",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
