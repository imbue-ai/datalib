load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:live.bzl", "live_run")

# A TNG account's Discord, every response about it and the files its
# messages carry, written by //tests/fixtures:make_discord_fixtures.py.
# Read by the central fixture pipeline at //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/discord_tng/**"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_discord",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_discord",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/discord_config:datalib_etl_discord_config",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/sql:datalib_sql",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
    ],
)

rust_test(
    name = "discord_unittests",
    size = "small",
    crate = ":datalib_etl_discord",
    edition = "2021",
)

# Every hermetic Discord test in one binary, against playback tapes; the
# modules are listed in its `main.rs`. The `live` module reaches the real
# account and is skipped here; `bazel run :discord_live` runs it.
rust_test(
    name = "discord_tests",
    srcs = glob(["tests/discord_tests/*.rs"]),
    args = [
        "--skip",
        "live::",
    ],
    crate_root = "tests/discord_tests/main.rs",
    edition = "2021",
    proc_macro_deps = ["@datalib_crates//:async-trait"],
    deps = [
        ":datalib_etl_discord",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/discord_config:datalib_etl_discord_config",
        "//datalib/backend/etl/web:datalib_etl_web",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/sql:datalib_sql",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

live_run(
    name = "discord_live",
    test = ":discord_tests",
)
