load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Schema-only config crate for the `google_drive` source.
# See AGENTS.md §"Repo layout" (why each provider has a <p>_config crate).
rust_library(
    name = "datalib_etl_google_drive_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_google_drive_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/source_common:datalib_source_common",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
    ],
)

rust_test(
    name = "google_drive_config_unittests",
    size = "small",
    crate = ":datalib_etl_google_drive_config",
    edition = "2021",
    deps = ["@datalib_crates//:toml"],
)
