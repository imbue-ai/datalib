load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Schema-only config crate for the linkedin source (Program A goal #1).
# Bazel-only by design (no Cargo.toml). See
# docs/dev/archived/data_processor_and_config_refactor.md §4.3.
rust_library(
    name = "datalib_etl_linkedin_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_linkedin_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/source_common:datalib_source_common",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
    ],
)

rust_test(
    name = "linkedin_config_unittests",
    size = "small",
    crate = ":datalib_etl_linkedin_config",
    edition = "2021",
)
