load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Checked-in ST:TNG-themed fixture, consumed by:
#   * the render crate's `beeper_roundtrip` test
#   * the unified //tests/fixtures:ingested_tng genrule that builds
#     `backend_index.doltlite_db` against every provider's fixtures.
#
# The fixture is SQL + a couple of small media files; the consumer
# lays out a Beeper-Texts-shaped dir from those before the download.
filegroup(
    name = "tng_fixture",
    srcs = glob([
        "tests/fixtures/beeper_tng/*.sql",
        "tests/fixtures/beeper_tng/media/**/*",
    ]),
    visibility = ["//visibility:public"],
)

# The fixture laid out as a Beeper Texts data directory, by Python for the
# reason //tests/fixtures:make_beeper_texts.py gives.
genrule(
    name = "tng_beeper_texts",
    srcs = [
        ":tng_fixture",
        "tests/fixtures/beeper_tng/index_db.sql",
    ],
    outs = [
        "tng_beeper_texts/index.db",
        "tng_beeper_texts/local-signal/megabridge.db",
        "tng_beeper_texts/media/local.beeper.com/TNGRPT01",
        "tng_beeper_texts/media/local.beeper.com/TNGAVWORF",
        "tng_beeper_texts/media/localhostlocal-signal/TNGART01",
        "tng_beeper_texts/media/localhostlocal-signal/TNGAVDATA",
    ],
    cmd = "python3 $(execpath //tests/fixtures:make_beeper_texts.py) " +
          "$$(dirname $(execpath tests/fixtures/beeper_tng/index_db.sql)) " +
          "$(RULEDIR)/tng_beeper_texts",
    tools = ["//tests/fixtures:make_beeper_texts.py"],
    visibility = ["//datalib:__subpackages__"],
)

rust_library(
    name = "datalib_etl_beeper",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_beeper",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/files:datalib_etl_files",
        "//datalib/backend/etl/providers/beeper_config:datalib_etl_beeper_config",
        "//datalib/backend/etl/sqlite_mirror:datalib_etl_sqlite_mirror",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
    ],
)
