{
  "header": {
    "markdown_uuid": "c0000003-1701-4d00-8000-00000000c003",
    "source_fingerprint": "aa22ca8c4bb10fb522e77cb4abd3ea009b7e38ab7617adaeb1c80c143118f63c",
