=== anthropic_api/rendered_md/8f5a3f9f-43cc-5dc6-96fc-d0cd78cb0bc9/all.grid_rows.json ===
{
  "header": {
    "markdown_uuid": "8f5a3f9f-43cc-5dc6-96fc-d0cd78cb0bc9",
    "source_fingerprint": "d6914e98346b823621af253e691f4f244432c30be7007d6eb46c7aa629f6932d",
