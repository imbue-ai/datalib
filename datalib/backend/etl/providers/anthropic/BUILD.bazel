load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# Filegroup for the checked-in TNG-themed fixture used by both Rust
# integration tests here and the Python fixture-build pipeline at
# //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/anthropic_api/**/*.json"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_anthropic",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_anthropic",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/anthropic_config:datalib_etl_anthropic_config",
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/index_lib:datalib_index_lib",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:clap",
        "@datalib_crates//:once_cell",
        "@datalib_crates//:regex",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:uuid",
    ],
)

rust_binary(
    name = "anthropic_download",
    srcs = ["src/bin/anthropic_download.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_anthropic",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "anthropic_playback_roundtrip",
    srcs = ["tests/playback_roundtrip.rs"],
    crate_root = "tests/playback_roundtrip.rs",
    edition = "2021",
    deps = [
        ":datalib_etl_anthropic",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# Integration test for --reset-and-redownload: synth a playback fixture,
# fetch, reset, refetch, assert per-row data-table equality. Verifies
# PK design is stable across re-downloads.
rust_test(
    name = "anthropic_reset_and_redownload",
    srcs = ["tests/reset_and_redownload.rs"],
    crate_root = "tests/reset_and_redownload.rs",
    edition = "2021",
    deps = [
        ":datalib_etl_anthropic",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# End-to-end coverage for the Claude Projects mirror: synthesize →
# download → doltlite → render::parse. The insta golden only exercises
# the legacy JSON-tree parse path, which is not what production runs.
rust_test(
    name = "anthropic_projects",
    srcs = ["tests/anthropic_projects.rs"],
    crate_root = "tests/anthropic_projects.rs",
    edition = "2021",
    deps = [
        ":datalib_etl_anthropic",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "anthropic_unittests",
    size = "small",
    crate = ":datalib_etl_anthropic",
    edition = "2021",
)

# Translate smoke test against the in-crate TNG fixture. Bazel stages
# the fixture via `data` and points `ANTHROPIC_FIXTURE_DIR` at the
# runfiles-relative path (the test reads it with CARGO_MANIFEST_DIR
# as the cargo fallback).
rust_test(
    name = "anthropic_translate_test",
    srcs = ["tests/anthropic_translate.rs"],
    crate_root = "tests/anthropic_translate.rs",
    data = [":tng_fixture"],
    edition = "2021",
    env = {
        "ANTHROPIC_FIXTURE_DIR": "datalib/backend/etl/providers/anthropic/tests/fixtures/anthropic_api",
    },
    deps = [
        ":datalib_etl_anthropic",
    ],
)

rust_test(
    name = "anthropic_live",
    srcs = ["tests/anthropic_live.rs"],
    crate_root = "tests/anthropic_live.rs",
    data = glob(["tests/snapshots/anthropic_live__*.snap"], allow_empty = True),
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
    },
    tags = [
        "external",  # talks to claude.ai/api
        "manual",
        "no-sandbox",  # latchkey reads keyring + LATCHKEY_CURL from host
    ],
    deps = [
        ":datalib_etl_anthropic",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "anthropic_render",
    srcs = ["tests/anthropic_render.rs"],
    crate_root = "tests/anthropic_render.rs",
    data = glob(["tests/snapshots/*.snap"], allow_empty = True) + [":tng_fixture"],
    edition = "2021",
    env = {
        "ANTHROPIC_FIXTURE_DIR": "datalib/backend/etl/providers/anthropic/tests/fixtures/anthropic_api",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    deps = [
        ":datalib_etl_anthropic",
        "//datalib/backend/etl:datalib_etl",
        "@datalib_crates//:insta",
        "@datalib_crates//:tempfile",
    ],
)

insta_update(
    name = "anthropic_render.update",
    test = ":anthropic_render",
    extra_data = [":tng_fixture"],
    extra_env = {
        "ANTHROPIC_FIXTURE_DIR": "datalib/backend/etl/providers/anthropic/tests/fixtures/anthropic_api",
    },
)

insta_update(
    name = "anthropic_live.update",
    test = ":anthropic_live",
    test_args = ["--ignored"],
)
