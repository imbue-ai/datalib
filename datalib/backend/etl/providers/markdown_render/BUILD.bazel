load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Render half of the `markdown` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/markdown is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_markdown_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_markdown_render",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/markdown:datalib_etl_markdown",
        "//datalib/backend/etl/providers/markdown_config:datalib_etl_markdown_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:url",
    ],
)

rust_test(
    name = "markdown_render_unittests",
    size = "small",
    crate = ":datalib_etl_markdown_render",
    edition = "2021",
)
