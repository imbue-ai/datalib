load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Render half of the `slack` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/slack is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_slack_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_slack_render",
    edition = "2021",
    compile_data = ["//third-party/emoji-data:slack_shortcodes.tsv"],
    # rules_rust makes an `execpath` absolute, as `include_str!` needs.
    rustc_env = {
        "SLACK_SHORTCODES_TSV": "$(execpath //third-party/emoji-data:slack_shortcodes.tsv)",
    },
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/contact_schema:datalib_contact_schema",
        "//datalib/backend/handle:datalib_handle",
        "//datalib/backend/etl/chat-common:datalib_etl_chat_common",
        "//datalib/backend/etl/providers/slack:datalib_etl_slack",
        "//datalib/backend/etl/providers/slack_config:datalib_etl_slack_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/id:datalib_id",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:regex",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "slack_render_unittests",
    size = "small",
    crate = ":datalib_etl_slack_render",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)
