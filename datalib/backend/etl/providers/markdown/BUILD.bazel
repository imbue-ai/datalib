load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# A small TNG notes folder in an Obsidian vault's shape: nested folders,
# a note with properties, one that is not UTF-8, and the `.obsidian/` and
# `.trash/` folders a vault keeps, which the scan never opens.
filegroup(
    name = "tng_fixture",
    srcs = glob(
        ["tests/fixtures/markdown_tng/**/*"],
        allow_empty = False,
    ),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_markdown",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_markdown",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/files:datalib_etl_files",
        "//datalib/backend/etl/providers/markdown_config:datalib_etl_markdown_config",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:sqlx",
    ],
)

rust_test(
    name = "markdown_unittests",
    size = "small",
    crate = ":datalib_etl_markdown",
    edition = "2021",
    deps = ["@datalib_crates//:tempfile"],
)

# End-to-end: scan the fixture folder, edit, move and delete notes, and
# render, asserting on the store and the documents rather than on logs.
rust_test(
    name = "markdown_e2e",
    size = "small",
    srcs = ["tests/markdown_e2e.rs"],
    data = [":tng_fixture"],
    edition = "2021",
    env = {"MARKDOWN_FIXTURE_DIR": "datalib/backend/etl/providers/markdown/tests/fixtures/markdown_tng"},
    deps = [
        ":datalib_etl_markdown",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/files:datalib_etl_files",
        "//datalib/backend/etl/providers/markdown_config:datalib_etl_markdown_config",
        "//datalib/backend/etl/providers/markdown_render:datalib_etl_markdown_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
