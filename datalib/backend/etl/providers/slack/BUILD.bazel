load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# Filegroup for the checked-in TNG-themed fixture used by both Rust
# integration tests here and the Python fixture-build pipeline at
# //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob([
        "tests/fixtures/slack_api*/**/*.jsonl",
        "tests/fixtures/slack_api*/media/**/*",
    ]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_slack",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_slack",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/slack_config:datalib_etl_slack_config",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Extract step (Slack). CLI driver. Emits structured tracing events:
# pretty on a TTY, NDJSON on stderr otherwise, plus optional OTLP
# export via --otlp-endpoint. Shells out to host `latchkey` at runtime.
rust_binary(
    name = "slack_ingest",
    srcs = ["src/bin/slack_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_slack",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_test(
    name = "slack_unittests",
    size = "small",
    crate = ":datalib_etl_slack",
    edition = "2021",
)

# Every hermetic Slack test in one binary; `tests/slack_tests/main.rs`
# lists the modules. Bazel stages the TNG fixture via
# `data = [":tng_fixture"]` and points `SLACK_FIXTURE_DIR` at the
# runfiles-relative path (the test source reads that env var with
# CARGO_MANIFEST_DIR as the cargo fallback). insta names a snapshot
# file after the module path, so the render module's goldens are
# `slack_tests__slack_render__*.snap` beside it; the target name
# matches the directory so cargo, which also discovers
# `tests/<dir>/main.rs`, agrees with bazel on that path.
rust_test(
    name = "slack_tests",
    srcs = glob(["tests/slack_tests/*.rs"]),
    crate_root = "tests/slack_tests/main.rs",
    data = glob(["tests/slack_tests/snapshots/*.snap"], allow_empty = True) + [":tng_fixture"],
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
        "RUST_TEST_THREADS": "1",
        "SLACK_FIXTURE_DIR": "datalib/backend/etl/providers/slack/tests/fixtures/slack_api",
    },
    deps = [
        "//datalib/backend/etl/providers/slack_config:datalib_etl_slack_config",
        "//datalib/backend/etl/providers/slack_render:datalib_etl_slack_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/pin:datalib_pin",
        ":datalib_etl_slack",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "slack_tests.update",
    test = ":slack_tests",
    extra_data = [":tng_fixture"],
    extra_env = {
        "SLACK_FIXTURE_DIR": "datalib/backend/etl/providers/slack/tests/fixtures/slack_api",
    },
)
