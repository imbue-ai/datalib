load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Schema-only config crate for claude_api / claude_export.
# Bazel-only by design (no Cargo.toml). See
# AGENTS.md, "Why each provider has a <p>_config crate".
rust_library(
    name = "datalib_etl_claude_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_claude_config",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/source_common:datalib_source_common",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
    ],
)

rust_test(
    name = "claude_config_unittests",
    size = "small",
    crate = ":datalib_etl_claude_config",
    edition = "2021",
    # The default-agreement tests parse real TOML, so the test needs the
    # TOML parser even though the library itself is serde-only.
    deps = ["@datalib_crates//:toml"],
)
