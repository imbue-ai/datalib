load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

exports_files(["Cargo.toml"])

# Filegroup for the checked-in TNG-themed fixture used by both Rust
# integration tests here and the Python fixture-build pipeline at
# //tests/fixtures:ingested_tng.
filegroup(
    name = "tng_fixture",
    srcs = glob(["tests/fixtures/claude_export/**/*.json"]),
    visibility = ["//visibility:public"],
)

rust_library(
    name = "datalib_etl_claude",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    crate_name = "datalib_etl_claude",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/etl/providers/claude_config:datalib_etl_claude_config",
        "//datalib/backend/probe:datalib_probe",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

rust_binary(
    name = "claude_ingest",
    srcs = ["src/bin/claude_ingest.rs"],
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        ":datalib_etl_claude",
        "//datalib/backend/obs:datalib_obs",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
    ],
)

# Every hermetic Claude test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "claude_tests",
    srcs = glob(["tests/claude_tests/*.rs"]),
    crate_root = "tests/claude_tests/main.rs",
    data = glob(["tests/claude_tests/snapshots/*.snap"], allow_empty = True) + [
        ":tng_fixture",
    ],
    edition = "2021",
    env = {
        "CLAUDE_FIXTURE_DIR": "datalib/backend/etl/providers/claude/tests/fixtures/claude_export",
        "INSTA_WORKSPACE_ROOT": ".",
        "RUST_TEST_THREADS": "1",
    },
    deps = [
        "//datalib/backend/etl/providers/claude_render:datalib_etl_claude_render",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        ":datalib_etl_claude",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "claude_unittests",
    size = "small",
    crate = ":datalib_etl_claude",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
        "@datalib_crates//:toml",
    ],
)

rust_test(
    name = "claude_live",
    srcs = ["tests/claude_live.rs"],
    crate_root = "tests/claude_live.rs",
    data = glob(["tests/snapshots/claude_live__*.snap"], allow_empty = True),
    edition = "2021",
    env = {
        "INSTA_WORKSPACE_ROOT": ".",
    },
    tags = [
        "external",  # talks to claude.ai/api
        "manual",
        "no-remote-exec",
        "no-sandbox",  # latchkey reads keyring + LATCHKEY_CURL from host
    ],
    deps = [
        ":datalib_etl_claude",
        "@datalib_crates//:insta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

insta_update(
    name = "claude_tests.update",
    test = ":claude_tests",
    extra_data = [":tng_fixture"],
    extra_env = {
        "CLAUDE_FIXTURE_DIR": "datalib/backend/etl/providers/claude/tests/fixtures/claude_export",
    },
)

insta_update(
    name = "claude_live.update",
    test = ":claude_live",
    test_args = ["--ignored"],
)

# `manual` keeps these out of `//...`, so nothing else ever builds them.
# See scripts/lint_repo.py check 7.
build_test(
    name = "manual_targets_build",
    targets = [
        ":claude_live",
    ],
)
