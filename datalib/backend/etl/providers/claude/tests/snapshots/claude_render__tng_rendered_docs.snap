{
  "edges": [],
  "render_version": 8,
  "rows": [
    {
      "account": "jlpicard@enterprise.starfleet.test",
      "author": "Jean-Luc Picard",
      "byte_size": 565,
      "channel": "Bridge Operations",
      "conversation_name": "Bridge Operations",
      "conversation_uuid": "00000000-0000-8da1-84c9-7ed998e5bd85",
      "created_at": "2364-03-01T09:00:00+00:00",
      "diff_changed_columns": null,
      "diff_status": null,
      "entire_chat": "/chat/00000000-0000-8da1-84c9-7ed998e5bd85",
      "git_sha": null,
      "is_document": true,
      "item_count": 4,
      "kind": "Project",
      "markdown_uuid": "00000000-0000-8da1-84c9-7ed998e5bd85",
      "message_index": null,
      "modified_at": "2364-03-02T11:30:00+00:00",
      "notion_block_uuid": null,
      "notion_page_uuid": null,
      "org_name": "USS Enterprise",
      "org_uuid": "0aa00000-1701-4d00-8000-0000000000aa",
      "project": "Bridge Operations",
      "provider": "claude",
      "qmd_path": "claude_export/render_markdown/00000000-0000-8da1-84c9-7ed998e5bd85/all.md",
      "source_label": "Claude",
      "source_url": "https://claude.ai/project/70000001-1701-4d00-8000-000000000701",
      "text": "Standing context for bridge-watch questions: ship status conventions, who to escalate to, and how to phrase a hail.\nAnswer as a Starfleet operations officer. Cite the relevant General Order when one applies, and never speculate about Borg activity without a sensor reading.\n# Hailing frequencies\n\nOpen on subspace band 3 unless the target is cloaked.\n\n- Klingon vessels: lead with rank, then ship name.\n- Romulan vessels: do not open first.\n\nOps -> Tactical (Worf) -> First Officer (Riker) -> Captain (Picard).\nMedical emergencies route directly to Sickbay (Crusher).\n",
      "upstream_entity_kind": "project",
      "upstream_id": "70000001-1701-4d00-8000-000000000701",
      "upstream_scope": null,
      "uuid": "00000000-0000-8da1-84c9-7ed998e5bd85"
    },
    {
      "account": "jlpicard@enterprise.starfleet.test",
      "author": "Description",
      "byte_size": 115,
      "channel": "Bridge Operations",
      "conversation_name": "Bridge Operations",
      "conversation_uuid": "00000000-0000-8da1-84c9-7ed998e5bd85",
      "created_at": "2364-03-01T09:00:00+00:00",
      "diff_changed_columns": null,
      "diff_status": null,
      "entire_chat": "/chat/00000000-0000-8da1-84c9-7ed998e5bd85",
