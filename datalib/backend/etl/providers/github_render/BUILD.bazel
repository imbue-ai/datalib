load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Render half of the `github` provider. This is the side that knows
# `datalib_schema`; //datalib/backend/etl/providers/github is the
# download half and deliberately does not.
rust_library(
    name = "datalib_etl_github_render",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_etl_github_render",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/etl/providers/github:datalib_etl_github",
        "//datalib/backend/etl/providers/github_config:datalib_etl_github_config",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:once_cell",
        "@datalib_crates//:regex",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "github_render_unittests",
    size = "small",
    crate = ":datalib_etl_github_render",
    edition = "2021",
)
