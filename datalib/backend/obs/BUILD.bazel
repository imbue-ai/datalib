load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

# Editing this crate re-embeds the qmd index on CI. `qmd_indexer_bin`
# links exactly this crate and //datalib/backend/runtime, and it is a
# bazel `tools=` input to //tests/fixtures:ingested_tng_qmd — which keys
# on its tools' digests. So any change here, comments included, re-runs a
# ~90s CPU-only embed of the whole fixture corpus. Not a reason to avoid
# editing it; a reason to know the bill. See src/lib.rs.
#
# Shared observability init for every datalib Rust binary: stderr
# fmt layer (pretty or JSON), an `IndicatifWriter` that coordinates
# log emission with a shared `MultiProgress` (exposed via
# `shared_multi()`), optional OTLP exporter, and EnvFilter wired to
# `RUST_LOG` / `--log-level`. Provider binaries flatten `ObsArgs` into
# their clap parser and call `init`.
rust_library(
    name = "datalib_obs",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_obs",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "@datalib_crates//:anyhow",
        "@datalib_crates//:clap",
        "@datalib_crates//:indicatif",
        "@datalib_crates//:opentelemetry",
        "@datalib_crates//:opentelemetry-otlp",
        "@datalib_crates//:opentelemetry_sdk",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:tracing-indicatif",
        "@datalib_crates//:tracing-opentelemetry",
        "@datalib_crates//:tracing-subscriber",
    ],
)

# Runs this crate's inline `#[cfg(test)]` unit tests under `bazel test`.
# Present (even with no tests today) so that the moment one is added it
# actually runs, and to satisfy the repo-wide invariant enforced by
# //tools/check_rust_unit_tests.sh.
rust_test(
    name = "datalib_obs_unittests",
    size = "small",
    crate = ":datalib_obs",
    edition = "2021",
)
