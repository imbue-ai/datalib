load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    # Canonical version constant, read by //tools:version_pins_test.
    "src/node_runtime.rs",  # LATCHKEY_VERSION
])

rust_library(
    name = "datalib_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_core",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/obs:datalib_obs",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:chrono",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:serde_yaml",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:tokio",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "core_unittests",
    size = "small",
    crate = ":datalib_core",
    edition = "2021",
    deps = [
        "@datalib_crates//:tempfile",
    ],
)
