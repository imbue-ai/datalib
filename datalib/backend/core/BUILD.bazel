load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "datalib_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_core",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:thiserror",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "core_unittests",
    size = "small",
    crate = ":datalib_core",
    edition = "2021",
    deps = [
        "@datalib_crates//:tokio",
        "@datalib_crates//:tempfile",
    ],
)
