load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

# The run store: a plain-SQLite file the runner writes and anything can
# read — step states, log lines and metrics, across runs — plus the app
# server's own log. The tables are `app_schema::runs`; this is the
# writers, the reader, and the tracing layer that feeds a writer.
# Deliberately light on datalib dependencies (the schema crate and
# `datalib_time`): the runner takes it without taking `datalib_core`,
# and `datalib-http` takes it to read what the runner wrote and to
# write its own lines.
rust_library(
    name = "datalib_runs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/flock:datalib_flock",
        "//datalib/backend/log_filter:datalib_log_filter",
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/store_meta:datalib_store_meta",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:tracing-subscriber",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "runs_unittests",
    size = "small",
    crate = ":datalib_runs",
    edition = "2021",
)

# Every hermetic run store test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
# One writer of the store, as its own process, for the concurrency test
# below: the runner's or a server's. A binary rather than a second
# writer inside the test, because what is under test is two *processes*
# contending for SQLite's write lock on one file — writers in one
# process would share a library, a page cache and a set of POSIX locks.
# `testonly` and under `tests/`: nothing shipped may link it, and cargo
# does not pick it up as a bin of this crate.
rust_binary(
    name = "runs_two_process",
    testonly = True,
    srcs = ["tests/bin/runs_two_process.rs"],
    edition = "2021",
    deps = [
        ":datalib_runs",
        "@datalib_crates//:serde_json",
    ],
)

# Does every line four processes publish at once reach the store?
# Hermetic: the data root is a tempdir and the only program it runs is
# the writer above, from runfiles.
rust_test(
    name = "runs_two_process_test",
    size = "medium",
    srcs = ["tests/runs_two_process.rs"],
    data = [":runs_two_process"],
    edition = "2021",
    env = {
        "HELPER_BIN": "$(rootpath :runs_two_process)",
    },
    deps = [
        ":datalib_runs",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "runs_tests",
    srcs = glob(["tests/runs_tests/*.rs"]),
    crate_root = "tests/runs_tests/main.rs",
    edition = "2021",
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/time:datalib_time",
        ":datalib_runs",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

