load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The run store: a plain-SQLite file the runner writes and anything can
# read — step states, log lines and metrics, across runs — plus the app
# server's own log. The tables are `app_schema::runs`; this is the
# writers, the reader, and the tracing layer that feeds a writer.
# Deliberately light on datalib dependencies (the schema crate and
# `datalib_time`): the runner takes it without taking `datalib_core`,
# and `datalib-http` takes it to read what the runner wrote and to
# write its own lines.
rust_library(
    name = "datalib_runs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/log_filter:datalib_log_filter",
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/store_meta:datalib_store_meta",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:tracing-subscriber",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "runs_unittests",
    size = "small",
    crate = ":datalib_runs",
    edition = "2021",
)

# The load-bearing experiment, run against the real engine: that
# `doltlite_engine=sqlite` survives sqlx and reaches doltlite, so the
# store on disk is stock SQLite. Everything else here rests on it.
rust_test(
    name = "stock_sqlite_engine_test",
    srcs = ["tests/stock_sqlite_engine.rs"],
    edition = "2021",
    deps = [
        ":datalib_runs",
        "//datalib/backend/app_schema:app_schema",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)

# The store end to end: publish, read back, the coalescing rules, and
# retention.
rust_test(
    name = "store_roundtrip_test",
    srcs = ["tests/store_roundtrip.rs"],
    edition = "2021",
    deps = [
        ":datalib_runs",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)
