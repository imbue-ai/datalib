load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "app_schema",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "app_schema",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        # For the `BulkUpsertable` impl `PortableTable` generates; the
        # impl itself binds through sqlx.
        "//datalib/backend/table:datalib_table",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
    ],
)

rust_test(
    name = "app_schema_unittests",
    size = "small",
    crate = ":app_schema",
    edition = "2021",
    deps = [
        "@datalib_crates//:serde_json",
        "@datalib_crates//:strum",
    ],
)
