load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "app_schema",
    srcs = [
        "src/disk_usage.rs",
        "src/feedback.rs",
        "src/lib.rs",
        "src/sync_jobs.rs",
    ],
    crate_name = "app_schema",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        # For the `BulkUpsertable` impl `PortableTable` now generates:
        # the trait lives in `datalib_schema::bulk` and the impl binds
        # through sqlx.
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
    ],
)

rust_test(
    name = "app_schema_unittests",
    size = "small",
    crate = ":app_schema",
    edition = "2021",
)
