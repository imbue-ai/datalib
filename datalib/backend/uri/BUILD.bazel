load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# Datalib's names, `datalib:<kind>/<id>` (README.md):
# written by whatever links to a thing, read by whatever opens one. Its
# one dependency, uuid_text, has none, so anything can link it. Bazel-only.
rust_library(
    name = "datalib_uri",
    srcs = ["src/lib.rs"],
    crate_name = "datalib_uri",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = ["//datalib/backend/uuid_text:datalib_uuid_text"],
)

rust_test(
    name = "uri_unittests",
    size = "small",
    # The cases the UI's `uri.ts` is tested against too.
    compile_data = ["//datalib/ui:tests/uri-fixtures.json"],
    crate = ":datalib_uri",
    edition = "2021",
    deps = [
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
    ],
)
