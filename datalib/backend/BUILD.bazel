load("@rules_shell//shell:sh_test.bzl", "sh_test")

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    # Wired into `bazelisk build --config=clippy` via .bazelrc — see
    # `--@rules_rust//rust/settings:clippy.toml=//datalib/backend:clippy.toml`.
    "clippy.toml",
])

# Enforces that every copy of the project version matches
# [workspace.package].version in datalib/backend/Cargo.toml (the single
# source of truth): the `rust_binary version = "..."` attrs in dag's and
# http's BUILD.bazel, and `ARG PROD_IMAGE_TAG` in .devcontainer/Dockerfile.
# Picked up by `bazelisk test //...`; fails with a diff that names both
# files so the bump is obvious.
sh_test(
    name = "version_consistency_test",
    size = "small",
    srcs = ["//tools:check_version_consistency.sh"],
    data = [
        "Cargo.toml",
        "//.devcontainer:Dockerfile",
        "//datalib/backend/dag:BUILD.bazel",
        "//datalib/backend/http:BUILD.bazel",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Asserts every `datalib-*` workspace crate in Cargo.lock is pinned
# to the version declared by [workspace.package].version in Cargo.toml.
# Catches the common drift where `CARGO_BAZEL_REPIN=1 bazel test //...`
# cache-hits every target after a version bump and Cargo.lock silently
# stays at the old version. Failure message points at //tools:repin_cargo.sh
# for the fix.
sh_test(
    name = "cargo_lock_versions_test",
    size = "small",
    srcs = ["//tools:check_cargo_lock_versions.sh"],
    data = [
        "Cargo.lock",
        "Cargo.toml",
    ],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Set of rust_binary targets bundled into the install.sh release tarball.
# Adding a binary here gets it shipped to users on the next tagged release;
# .github/workflows/release.yml renames each bazel output to its public
# `datalib-<name>` form before tarring, and scripts/install.sh drops
# the result into the user's install dir (default ~/.local/bin).
filegroup(
    name = "dist",
    srcs = [
        # The dispatch curl + the impersonator it fronts are both bundled
        # because every CF-fronted provider (claude.ai, chatgpt.com,
        # files.slack.com) 403s on vanilla curl's TLS fingerprint.
        # `datalib-step` resolves the dispatch curl from `LATCHKEY_CURL`,
        # `DATALIB_CURL_DISPATCH`, or a sibling-of-self lookup against
        # `latchkey-curl-dispatch` — see
        # `datalib_etl::latchkey::ensure_curl_dispatch` — and the dispatch
        # curl finds the impersonator as a sibling. Keep the public name
        # mapping in release.yml's stage step in sync with the sibling-name
        # list in latchkey.rs.
        "//datalib/backend/etl:latchkey_curl_dispatch",
        "//datalib/backend/etl:latchkey_curl_impersonate",
        # HTTP backend with the Vite-built UI embedded via rust-embed
        # (see datalib/backend/http/src/embed.rs). Single binary
        # serves the full search experience given a data root path —
        # `datalib-http <data_root>` is the user-facing invocation.
        "//datalib/backend/http:datalib_http_bin",
        # The DAG runner + step host, spawned by http's sync worker (and
        # invocable standalone against a data root's config.toml).
        "//datalib/backend/dag:datalib_dag_bin",
        "//datalib/backend/datalib_step:datalib_step",
        # One-shot converter from a pre-TOML `config.yaml`. Ships so an
        # upgrading user can actually run it; nothing else invokes it,
        # and it is the only shipped binary that links a YAML parser.
        "//datalib/backend/migrate_config:datalib_migrate_config_bin",
        # The reference applet. Ships for the same reason `datalib-step`
        # does: a config can name it, and the http gateway resolves an
        # applet's `command` against its own directory (then
        # `~/.datalib/bin`, then PATH). Without it here, a
        # `command = "datalib-view-slack"` entry would only work for a
        # user who installed the binary by hand.
        "//datalib/backend/applets/slack:datalib_view_slack",
    ],
    visibility = ["//visibility:public"],
)

# The curl-only distribution: just the dispatch curl and the
# impersonating curl it fronts. Published as a separate, smaller tarball
# (`curl-<triple>.tar.gz`) for consumers — e.g. the minds
# latchkey gateway — that only need a `curl` that impersonates Chrome on
# demand and don't want the rest of the datalib toolchain. Keep the
# public-name mapping in release.yml's "Stage curl tarball" step in sync
# with this list.
filegroup(
    name = "curl_dist",
    srcs = [
        "//datalib/backend/etl:latchkey_curl_dispatch",
        "//datalib/backend/etl:latchkey_curl_impersonate",
    ],
    visibility = ["//visibility:public"],
)
