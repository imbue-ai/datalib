load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "BUILD.bazel",  # read by //datalib/backend:version_consistency_test
    # Canonical version constants, read by //tools:version_pins_test
    # (and by //tools:qmd_model_cache_path_test for the qmd one).
    "src/node_runtime.rs",  # LATCHKEY_VERSION
    "src/qmd.rs",  # DEFAULT_QMD_VERSION
])

# The data-root layout plus the bundled-Node/npx resolution every binary
# shares. No first-party dependencies, so any crate can link it; its
# third-party ones, tempfile and url, are in every test tree already.
rust_library(
    name = "datalib_runtime",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_runtime",
    edition = "2021",
    # Sets CARGO_PKG_VERSION, which `build_id::DATALIB_VERSION` reads:
    # this is the crate every store-owning binary links, so it is where
    # "which datalib wrote this store" comes from. Must match
    # [package].version in datalib/backend/Cargo.toml;
    # //datalib/backend:version_consistency_test asserts that.
    version = "0.51.0",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "@datalib_crates//:tempfile",
        "@datalib_crates//:url",
    ],
)

rust_test(
    name = "runtime_unittests",
    size = "small",
    crate = ":datalib_runtime",
    edition = "2021",
)

# A bundled tool, run by the pinned Node, ignores the debugger signal.
rust_test(
    name = "debug_signal_test",
    size = "small",
    srcs = ["tests/debug_signal.rs"],
    data = ["@nodejs_host//:node_bin"],
    edition = "2021",
    env = {"NODE_RLOC": "$(rlocationpath @nodejs_host//:node_bin)"},
    deps = [
        ":datalib_runtime",
        "@datalib_crates//:libc",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:tempfile",
    ],
)

# What a run of the pinned latchkey does when datalib starts it.
rust_test(
    name = "latchkey_counting_test",
    size = "small",
    srcs = ["tests/latchkey_counting.rs"],
    data = [
        "//third-party/latchkey/runtime:latchkey_package_dir",
        "//third-party/latchkey/runtime:latchkey_tree",
        "@nodejs_host//:node_bin",
    ],
    edition = "2021",
    env = {
        "LATCHKEY_PACKAGE_RLOC": "$(rlocationpath //third-party/latchkey/runtime:latchkey_package_dir)",
        "NODE_RLOC": "$(rlocationpath @nodejs_host//:node_bin)",
    },
    deps = [
        ":datalib_runtime",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:tempfile",
    ],
)
