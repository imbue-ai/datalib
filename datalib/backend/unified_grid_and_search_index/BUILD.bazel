load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")
load(":search_fixture.bzl", "SEARCH_FIXTURE_DATA", "SEARCH_FIXTURE_ENV")

# The unified grid and search index: the grid index, the search index's query
# side, and the query language over them.
#
# Visibility is the point of this crate existing. Only the step that
# writes the indexes and the applet that serves them may link it —
# `datalib-http` and `datalib-dag` must not, which is what makes "core
# does not know about the unified grid and search index" checkable rather than a
# convention.
rust_library(
    name = "datalib_unified_grid_and_search_index",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "datalib_unified_grid_and_search_index",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "//datalib/backend/step_problems:datalib_step_problems",
        "//datalib/backend/table:datalib_table",
        "//datalib/backend/columns:datalib_columns",
        "//datalib/backend/contact_schema:datalib_contact_schema",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/h3:datalib_h3",
        "//datalib/backend/handle:datalib_handle",
        "//datalib/backend/pin:datalib_pin",
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/search_index:datalib_search_index",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
        "@datalib_crates//:tokio",
    ],
)

rust_test(
    name = "unified_grid_and_search_index_unittests",
    size = "small",
    crate = ":datalib_unified_grid_and_search_index",
    edition = "2021",
    # A table of the tests' own, searched with `LIKE` (db.rs).
    proc_macro_deps = ["//datalib/backend/etl/macros:datalib_etl_macros"],
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

# The TNG fixture's data root with its search index, vectors and model,
# for the tests here and in the applet that search it.
rust_library(
    name = "search_fixture",
    testonly = True,
    srcs = ["tests/search_fixture/lib.rs"],
    crate_name = "datalib_search_fixture",
    edition = "2021",
    visibility = ["//datalib/backend/applets:__pkg__"],
    deps = [
        "//datalib/backend/runtime:datalib_runtime",
        "@datalib_crates//:runfiles",
    ],
)

# Every hermetic document-index test in one binary; the modules are listed in
# its `main.rs`. One binary, because a `rust_test` is a whole opt-mode
# link of the provider stack and that is most of what a test here costs.
rust_test(
    name = "unified_grid_and_search_index_tests",
    srcs = glob(["tests/unified_grid_and_search_index_tests/*.rs"]),
    crate_root = "tests/unified_grid_and_search_index_tests/main.rs",
    data = glob(["tests/unified_grid_and_search_index_tests/snapshots/*.snap"], allow_empty = True) + SEARCH_FIXTURE_DATA,
    edition = "2021",
    env = SEARCH_FIXTURE_ENV | {
        "INSTA_WORKSPACE_ROOT": ".",
    },
    deps = [
        "//datalib/backend/h3:datalib_h3",
        "@datalib_crates//:h3o",
        ":search_fixture",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/pin:datalib_pin",
        "//datalib/backend/query:datalib_query",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/schema:datalib_schema",
        "//datalib/backend/search_index:datalib_search_index",
        "//datalib/backend/table:datalib_table",
        ":datalib_unified_grid_and_search_index",
        "@datalib_crates//:insta",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
    ],
)



# (The documented example configs are validated by
# //datalib/backend/datalib_step:datalib_step_unittests, which plans
# them through the real dispatcher.)


insta_update(
    name = "unified_grid_and_search_index_tests.update",
    test = ":unified_grid_and_search_index_tests",
)

