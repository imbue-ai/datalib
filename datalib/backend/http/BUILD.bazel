load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "BUILD.bazel",  # read by //datalib/backend:version_consistency_test
    "Cargo.toml",
])

# The embedded UI bundle, pinned to the HOST platform. The Vite build
# always executes on the build host, but as `compile_data` it sits in
# the TARGET configuration — so under `--config=musl-*` (or any other
# cross-compile) rules_js would select() rollup's native binding for
# the *target* platform (e.g. `@rollup/rollup-linux-*-musl`) while the
# Vite action still executes on the host, dying with MODULE_NOT_FOUND.
# The bundle is platform-independent bytes, so transitioning it back
# to the host platform is safe, and is the standard rules_js
# cross-compilation fix.
platform_transition_filegroup(
    name = "ui_dist_host",
    srcs = ["//datalib/ui:dist"],
    target_platform = "@platforms//host",
)

rust_library(
    name = "datalib_http",
    srcs = [
        "src/applets.rs",
        "src/auth.rs",
        "src/boot.rs",
        "src/connect.rs",
        "src/frontend.rs",
        "src/embed.rs",
        "src/history.rs",
        "src/lib.rs",
        "src/lock.rs",
        "src/logging.rs",
        "src/manage/activity.rs",
        "src/manage/documents.rs",
        "src/manage/group.rs",
        "src/manage/mod.rs",
        "src/manage/problems.rs",
        "src/manage/status.rs",
        "src/remote_media.rs",
        "src/request_log.rs",
        "src/ui_events.rs",
        "src/usage.rs",
        "src/watch.rs",
        "src/worker.rs",
    ],
    crate_name = "datalib_http",
    edition = "2021",
    # `boot::NewerRootRepo` implements the async `AppRepo` trait.
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    # Sets CARGO_PKG_VERSION under rules_rust (which does NOT read
    # Cargo.toml) — /api/health and the feedback cards report it, and
    # since the Tauri shell ships this bazel-built binary, it's also the
    # desktop app's version. Must match [workspace.package].version in
    # datalib/backend/Cargo.toml; the
    # //datalib/backend:version_consistency_test asserts that.
    version = "0.36.1",
    # The rust-embed proc macro reads `$DATALIB_UI_DIST` (env-var
    # interpolation via the `interpolate-folder-path` feature). We
    # point it at the hermetic Bazel-built dist (via `:ui_dist_host`,
    # the host-platform-pinned wrapper above); the `compile_data`
    # entry makes those files visible to the rustc invocation.
    # `$(execpath)` expands to the execroot-relative path of the
    # directory output — usable directly from rustc's CWD (execroot).
    # The guide .md files are `include_str!`'d by the `/agent/cards.md`
    # and `/agent/config.md` handlers.
    compile_data = [
        ":ui_dist_host",
        "src/agent_cards_guide.md",
        "src/agent_config_guide.md",
    ],
    rustc_env = {
        "DATALIB_UI_DIST": "$(execpath :ui_dist_host)",
    },
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/columns:datalib_columns",
        "//datalib/backend/metrics:datalib_metrics",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/parent_watch:datalib_parent_watch",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/dag:datalib_dag",
        "//datalib/backend/history:datalib_history",
        "//datalib/backend/pin:datalib_pin",
        "//datalib/backend/runs:datalib_runs",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/store_meta:datalib_store_meta",
        "//datalib/backend/time:datalib_time",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:axum",
        "@datalib_crates//:chrono",
        "@datalib_crates//:futures",
        "@datalib_crates//:libc",
        "@datalib_crates//:mime_guess",
        "@datalib_crates//:notify",
        "@datalib_crates//:reqwest",
        "@datalib_crates//:rust-embed",
        "@datalib_crates//:serde",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sha2",
        "@datalib_crates//:shlex",
        "@datalib_crates//:strum",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:tracing-subscriber",
        "@datalib_crates//:url",
        "@datalib_crates//:uuid",
    ],
)

rust_test(
    name = "http_unittests",
    size = "small",
    crate = ":datalib_http",
    edition = "2021",
    proc_macro_deps = [
        "@datalib_crates//:async-trait",
    ],
    deps = [
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tower",
    ],
)

# The hermetic endpoint tests, one binary: each `tests/http_tests/*.rs`
# is one endpoint or one contract. Linking the server stack is most of
# what a test here costs, so they share the link; a test that installs
# the process's tracing subscriber stays its own target below.
# `remote_media` reaches a stand-in host on loopback (issue #648), hence
# the env that lifts the private-address guard; `worker_failure_tail`
# and `worker_cancel` run the real runner, hence the data.
rust_test(
    name = "http_tests",
    srcs = glob(["tests/http_tests/*.rs"]),
    crate_root = "tests/http_tests/main.rs",
    data = ["//datalib/backend/dag:datalib_dag_bin"],
    edition = "2021",
    env = {
        "DATALIB_DAG_BIN": "$(rootpath //datalib/backend/dag:datalib_dag_bin)",
        "DATALIB_REMOTE_MEDIA_ALLOW_PRIVATE": "1",
    },
    deps = [
        ":datalib_http",
        "//datalib/backend/app_schema:app_schema",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/dag:datalib_dag",
        "//datalib/backend/metrics:datalib_metrics",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/runs:datalib_runs",
        "@datalib_crates//:axum",
        "@datalib_crates//:futures",
        "@datalib_crates//:libc",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tower",
        "@datalib_crates//:url",
    ],
)

# Both start real applet processes and bind loopback ports (python3 for
# the proxy's fixture server), so neither can be sandboxed — same
# treatment as //datalib/ui:e2e_test. Pure store semantics stay
# hermetic as unit tests in src/frontend.rs.
rust_test(
    name = "applet_tests",
    srcs = glob(["tests/applet_tests/*.rs"]),
    crate_root = "tests/applet_tests/main.rs",
    data = ["//datalib/backend/applets:datalib_applet"],
    edition = "2021",
    env = {
        "APPLET_BIN": "$(rootpath //datalib/backend/applets:datalib_applet)",
    },
    tags = [
        "no-remote-exec",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        ":datalib_http",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/dag:datalib_dag",
        "//datalib/backend/etl/render:datalib_etl_render",
        "//datalib/backend/schema:datalib_schema",
        "@datalib_crates//:axum",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tower",
    ],
)

# The server's own log: a `tracing` event in this process reaches the
# store and comes back through `GET /api/log` as `process:http`.
rust_test(
    name = "server_log_test",
    srcs = ["tests/server_log.rs"],
    edition = "2021",
    deps = [
        ":datalib_http",
        "//datalib/backend/core:datalib_core",
        "//datalib/backend/runs:datalib_runs",
        "@datalib_crates//:axum",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tower",
        "@datalib_crates//:tracing",
    ],
)

# One line per request in the server's log, and none for a read of the
# log itself (the log panel would refetch on its own line forever).
rust_test(
    name = "request_log_test",
    srcs = ["tests/request_log.rs"],
    edition = "2021",
    deps = [
        ":datalib_http",
        "//datalib/backend/core:datalib_core",
        "@datalib_crates//:axum",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tower",
    ],
)

# A page of the app is a `ui` process; what it posts to
# `/api/ui/events` are its lines.
rust_test(
    name = "ui_events_test",
    srcs = ["tests/ui_events.rs"],
    edition = "2021",
    deps = [
        ":datalib_http",
        "//datalib/backend/core:datalib_core",
        "@datalib_crates//:axum",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:tempfile",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tower",
    ],
)

# Ctrl-C against the real binary while a client holds the SSE stream
# open: the graceful wait that would otherwise never end.
rust_test(
    name = "shutdown_test",
    size = "small",
    srcs = ["tests/shutdown.rs"],
    data = [":datalib_http_bin"],
    edition = "2021",
    env = {
        "DATALIB_HTTP_BIN": "$(rootpath :datalib_http_bin)",
    },
    deps = [
        "@datalib_crates//:tempfile",
    ],
)

rust_binary(
    name = "datalib_http_bin",
    srcs = ["src/main.rs"],
    edition = "2021",
    visibility = [
        "//datalib:__subpackages__",
        "//tests:__subpackages__",
    ],
    deps = [
        ":datalib_http",
        "//datalib/backend/fetch:datalib_fetch",
        "//datalib/backend/parent_watch:datalib_parent_watch",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:axum",
        "@datalib_crates//:clap",
        "@datalib_crates//:tokio",
        "@datalib_crates//:tracing",
        "@datalib_crates//:webbrowser",
    ],
)
