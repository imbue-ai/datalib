load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

# The `problems` table: one row per thing a step could not fully do to
# one record, in whichever store that step owns. A leaf crate so that
# both sides of the ingest/render split can write it — `datalib_etl`
# for a fetch that failed, the render crates for a payload that would
# not parse or a row that would not build. Bazel-only, no `Cargo.toml`:
# nothing outside bazel needs to see it, and a crate in the Cargo
# workspace rewrites `MODULE.bazel.lock` on every branch that adds one
# (AGENTS.md, "Git: prefer merges"). See src/lib.rs and
# docs/dev/plans/problem_visibility.md.
rust_library(
    name = "datalib_problems",
    srcs = ["src/lib.rs"],
    crate_name = "datalib_problems",
    edition = "2021",
    proc_macro_deps = [
        "//datalib/backend/etl/macros:datalib_etl_macros",
    ],
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/id:datalib_id",
        # `PortableTable` emits `impl ::datalib_table::BulkUpsertable`.
        "//datalib/backend/table:datalib_table",
        "@datalib_crates//:anyhow",
        "@datalib_crates//:serde",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:strum",
    ],
)

rust_test(
    name = "problems_unittests",
    size = "small",
    crate = ":datalib_problems",
    edition = "2021",
    deps = [
        "@datalib_crates//:serde_json",
    ],
)
