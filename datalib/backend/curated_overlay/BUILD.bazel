load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//tools:insta.bzl", "insta_update")

# A checked-in `datalib_curated/` laid over a data root, and the checks
# that it fits (README.md). Only tests link it: the TNG one here and the
# live bake (//datalib/backend/dag:manual_e2e_live_sync_golden).
rust_library(
    name = "datalib_curated_overlay",
    testonly = True,
    srcs = ["src/lib.rs"],
    crate_name = "datalib_curated_overlay",
    edition = "2021",
    visibility = ["//datalib:__subpackages__"],
    deps = [
        "//datalib/backend/contacts:datalib_contacts",
        "//datalib/backend/etl:datalib_etl",
        "//datalib/backend/problem_mutes:datalib_problem_mutes",
        "//datalib/backend/problems:datalib_problems",
        "//datalib/backend/runtime:datalib_runtime",
        "//datalib/backend/step_problems:datalib_step_problems",
        "//datalib/backend/store_dump:datalib_store_dump",
        "//datalib/backend/store_meta:datalib_store_meta",
        "@datalib_crates//:serde_json",
        "@datalib_crates//:sqlx",
        "@datalib_crates//:tokio",
        "@datalib_crates//:walkdir",
    ],
)

# The TNG fixture's curated stores (//tests/fixtures/curated) over the
# root `materialize_tng_root` builds. Fails when this build would change a
# checked-in store; `bazel run :tng_overlay_test.update` writes it back,
# with the snapshots.
rust_test(
    name = "tng_overlay_test",
    size = "medium",
    srcs = ["tests/tng.rs"],
    data = glob(
        ["tests/snapshots/*.snap"],
        allow_empty = True,
    ) + [
        "//datalib/backend/applets:datalib_applet",
        "//tests/fixtures:materialize_tng_root",
        "//tests/fixtures/curated:tng",
    ],
    edition = "2021",
    env = {
        "APPLET_RLOC": "$(rlocationpath //datalib/backend/applets:datalib_applet)",
        "MATERIALIZE_RLOC": "$(rlocationpath //tests/fixtures:materialize_tng_root)",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    deps = [
        ":datalib_curated_overlay",
        "@datalib_crates//:insta",
        "@datalib_crates//:runfiles",
        "@datalib_crates//:tempfile",
    ],
)

insta_update(
    name = "tng_overlay_test.update",
    test = ":tng_overlay_test",
)
