load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//datalib/ui:vite/package_json.bzl", vite_bin = "bin")
load("@npm//datalib/ui:vitest/package_json.bzl", vitest_bin = "bin")
load("@npm//datalib/ui:vue-tsc/package_json.bzl", vue_tsc_bin = "bin")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Materializes the npm dep graph from pnpm-lock.yaml into a virtual
# node_modules/ tree backing the js_run_binary action below.
# Resolved @playwright/test version, read by //tools:version_pins_test.
exports_files(["pnpm-lock.yaml"])

npm_link_all_packages(name = "node_modules")

# Vite binary exposed by the link target above. The `bin` symbol comes
# from the auto-generated `@npm//datalib/ui:vite/package_json.bzl`
# which lists every executable declared in vite's package.json#bin.
vite_bin.vite_binary(
    name = "vite",
    # Show vite's stdout on success so the "✓ N modules transformed"
    # build summary surfaces in bazel logs. Default rules_js behavior
    # suppresses action output on success.
    env = {
        "JS_BINARY__SILENT_ON_SUCCESS": "",
    },
)

# Hermetic vite build. Inputs are the static UI sources + linked
# node_modules; output is the `dist/` directory the rust-embed proc
# macro reads from at compile time.
#
# `chdir = package_name()` makes vite resolve `vite.config.ts` and
# entrypoints relative to this package, matching plain `pnpm build`.
# `out_dirs = ["dist"]` declares the directory output so downstream
# rules can depend on it; rules_js places it at
# `bazel-out/<config>/bin/datalib/ui/dist/`.
# Stage source files into bazel-bin so vite's path resolution stays
# entirely under bazel-out. Without this, vite ends up computing paths
# that mix execroot source-tree locations with bazel-out destinations,
# and rolldown's html-emit plugin rejects the resulting non-relative
# string ("must be neither absolute nor relative").
copy_to_bin(
    name = "vite_inputs",
    srcs = glob(
        [
            "src/**",
            "public/**",
        ],
        allow_empty = True,
    ) + [
        "index.html",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
)

js_run_binary(
    name = "dist",
    srcs = [
        ":node_modules",
        ":vite_inputs",
    ],
    out_dirs = ["dist"],
    chdir = package_name(),
    tool = ":vite",
    args = ["build"],
    visibility = ["//datalib:__subpackages__"],
)

# Playwright e2e suite, exposed two ways from the same wrapper script:
#   bazelisk run  //datalib/ui:e2e        — interactive
#   bazelisk test //datalib/ui:e2e_test   — picked up by `bazel test //...`
#
# In `test` mode the wrapper runs Playwright from the runfiles tree,
# using the bazel-linked `:node_modules` (materialized by rules_js from
# pnpm-lock.yaml). That makes the test independent of the source-tree
# `node_modules` — so a wedged host `pnpm install` (e.g. pnpm's
# auto-purge refusing without a TTY) can't break `bazel test //...`.
#
# Still NOT fully hermetic on two axes:
#   * Browser binaries: chromium AND webkit come from
#     ~/Library/Caches/ms-playwright via env_inherit=HOME, fetched on
#     demand by the `playwright install` run_e2e.sh does before the
#     suite (a no-op once cached — hence `requires-network`). Webkit is
#     there because the suite has a `webkit` project: the Tauri desktop
#     app runs in a WKWebView, and a Chromium-only suite has twice
#     missed a WebKit-specific layout bug that left an AG Grid
#     invisible. Putting the browsers into Bazel as real inputs is its
#     own project; see option (3) in the design discussion.
#   * `bazel run` mode: keeps using BUILD_WORKSPACE_DIRECTORY + the
#     source-tree node_modules so devs can edit specs and re-run
#     interactively. The hermetic node_modules is `test`-mode only.

# Materialize the e2e source set into bazel-out so the runfiles
# `tests/e2e/*.spec.ts` are real files, not symlinks back to the source
# tree. Playwright's spec-file discovery doesn't follow symlinks (Node's
# `fs.readdir(..., withFileTypes:true)` reports symlinks as
# `!isFile()`, so the walker skips them), which would leave us with
# "Error: No tests found" despite the symlinks resolving fine for
# `node` itself.
copy_to_bin(
    name = "e2e_inputs",
    srcs = [
        "package.json",
        "playwright.config.ts",
        "tsconfig.json",
    ] + glob(["tests/e2e/**/*"], allow_empty = False),
)

_E2E_DATA = [
    "//datalib/backend/http:datalib_http_bin",
    # The grid is served by the `unified_index` applet now, and the
    # fixture config names its binary by absolute path — so it has to be
    # in the runfiles or every grid spec sees an empty page.
    "//datalib/backend/applets:datalib_applet",
    "//tests/fixtures:materialize_tng_root",
    # The step host, for the spec that drives a real sync. The fixture
    # root is a temp dir with nothing on PATH and no `binary_dir`, so a
    # step's `command:` has to name an absolute path — which means the
    # binary has to be in the runfiles. `fsindex` is the step it runs:
    # file-backed, no network, no credentials, and read-only against the
    # tree it scans (`stamp` defaults off).
    # The DAG runner the http server's sync worker shells out to. Without
    # it every sync fails at startup with "datalib-dag binary not found",
    # which no spec noticed until one of them actually ran a sync.
    "//datalib/backend/dag:datalib_dag_bin",
    "//datalib/backend/datalib_step:datalib_step",
    # A local PDF corpus for that same spec. `pdf` is the local-only
    # provider that has BOTH halves — download and render — so a config
    # built on it exercises a real `raw -> rendered_md` edge, which is
    # what makes "everything downstream is queued too" a real assertion
    # rather than a contrived one.
    "//datalib/backend/etl/providers/pdf:pdf_fixture",
    # Signal, for the second source the onboarding spec adds. Two
    # pieces, because a Signal backup cannot be checked in: the spec
    # JSON, and the binary that expands it into a real *encrypted*
    # snapshot dir. That is the point of using it here — `pdf` proves a
    # local scan, and Signal proves the shape almost every real source
    # has: a credentialed provider whose download step decrypts with a
    # passphrase it reads from the environment. The AEP is 64 zeros and
    # public, which is what makes the crypto path runnable in a test.
    "//datalib/backend/signal-backup:signal_make_fixture",
    "//datalib/backend/etl/providers/signal:tng_fixture",
    # rules_js-linked node_modules built from pnpm-lock.yaml; replaces
    # the host `pnpm install` for the `bazel test` path.
    ":node_modules",
    ":e2e_inputs",
    # Node + the qmd package tree, which run_e2e.sh symlinks into a
    # `DATALIB_RUNTIME_DIR` layout so the applet's qmd resolves through
    # `bundled_command` instead of `npx -y @tobilu/qmd@<v>`.
    #
    # This is a correctness fix, not a speed one. npm keys the npx cache
    # (`~/.npm/_npx/<hash>`) on the package spec ALONE — no Node version
    # in it — so one directory is shared by every Node on the machine,
    # while a native module inside it may be built for exactly one ABI.
    # (When this was written the offender was named: better-sqlite3 12's
    # `node-v127` prebuilt. qmd 2.8.3 moved to better-sqlite3 13, whose
    # bindings are per-platform rather than per-ABI, so that particular
    # trap is closed — the staging below is kept because it also removes
    # the registry fetch, which was never only about the ABI.)
    # This test is the one qmd
    # consumer that reached npx, and it also `env_inherit`s PATH, so it
    # ran under whatever `node` the developer had while every Bazel
    # action uses the pinned PATH's Homebrew node. The two poisoned each
    # other's cache in a loop: whoever installed first won, and everyone
    # else died on NODE_MODULE_VERSION. Staging the same Bazel-managed
    # Node the fixture genrule uses removes the second Node entirely.
    "@nodejs_host//:node_bin",
    "//third-party/qmd/runtime:qmd_tree",
    "//third-party/qmd/runtime:package.json",
]

# Runfiles paths of the two staging inputs above, handed to run_e2e.sh
# rather than hardcoded: bzlmod mangles `@nodejs_host`'s repo name, so
# there is no stable string to write down.
_E2E_ENV = {
    "FW_E2E_NODE_BIN_RLOC": "$(rlocationpath @nodejs_host//:node_bin)",
    "FW_E2E_QMD_PKG_RLOC": "$(rlocationpath //third-party/qmd/runtime:package.json)",
}

_E2E_DEPS = ["@bazel_tools//tools/bash/runfiles"]

sh_binary(
    name = "e2e",
    srcs = ["run_e2e.sh"],
    data = _E2E_DATA,
    env = _E2E_ENV,
    deps = _E2E_DEPS,
)

sh_test(
    name = "e2e_test",
    srcs = ["run_e2e.sh"],
    data = _E2E_DATA,
    env = _E2E_ENV,
    deps = _E2E_DEPS,
    # An sh_test defaults to size=medium, i.e. a 300s timeout, and this
    # suite has outgrown it: 66 specs across two engines, with a qmd
    # daemon warm-up in front. Measured at 206s on an idle laptop after
    # the AG Grid 36 / Vite 8 bump, and it TIMED OUT at 300s on the same
    # machine while a bazel build was competing for cores. 300s is not a
    # budget, it is a coin flip, and a flaky merge gate teaches people to
    # re-run rather than to read. `long` (900s) is ~4x the observed
    # runtime; it bounds a genuine hang without failing a slow run.
    timeout = "long",
    # Needs network (Playwright fetches any missing browser binary —
    # chromium and webkit) and the host's pnpm / node / Playwright
    # cache, hence `no-sandbox` + `requires-network`. Do NOT re-add the `external` tag: this is a
    # routine UI integration test that must run on the default
    # `bazel test //...` path (and CI's
    # `--test_tag_filters=-manual,-external`). `requires-network`
    # already gates it out of hermetic / offline environments;
    # `external` would over-exclude.
    tags = [
        "no-sandbox",
        "requires-network",
    ],
    # Inherit the user's PATH and HOME so the script can find pnpm / node
    # and reuse ~/Library/Caches/ms-playwright (the browser cache) /
    # ~/.local/share/pnpm. Bazel scrubs the test env otherwise.
    env_inherit = [
        "PATH",
        "HOME",
        # Which browser engines run_e2e.sh provisions; unset means both
        # (`chromium webkit`, see run_e2e.sh). Nothing in .github/ sets
        # it — an earlier version of this comment claimed CI narrowed it
        # to chromium "whose OS libraries are the only ones the Linux
        # image bakes", which was never true of the workflow and is no
        # longer true of the image either: v0.30.1's devcontainer bakes
        # both engines via `playwright install --with-deps chromium
        # webkit`. CI therefore runs both, which is the point of the
        # webkit project.
        "E2E_BROWSERS",
    ],
)

# --- Hermetic TypeScript typecheck -----------------------------------
#
# Replaces `npx vue-tsc --noEmit` from scripts/run_checks.sh. That
# invocation needed a host `pnpm install` (and `corepack enable pnpm`
# before it) to have populated a source-tree node_modules; this one runs
# vue-tsc straight out of the rules_js-linked `:node_modules`, built from
# the integrity-pinned pnpm-lock.yaml. No host pnpm, no network, no
# `$HOME` — so it sandboxes and remote-caches.
#
# Inputs are staged into bazel-out rather than read from the source tree,
# matching `:vite_inputs`. tsconfig.json's `include` covers `src/**` and
# `tests/**`, so both have to be here or vue-tsc silently checks less
# than the `npx` version did. (aspect_bazel_lib memoizes the per-file
# copy action, so sharing package.json / tsconfig.json with the other
# `copy_to_bin` targets in this package is fine, not a conflict.)
copy_to_bin(
    name = "typecheck_inputs",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = False,
    ) + [
        "package.json",
        "tsconfig.json",
    ],
)

vue_tsc_bin.vue_tsc_test(
    name = "typecheck_test",
    args = [
        "--noEmit",
        "-p",
        "tsconfig.json",
    ],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":typecheck_inputs",
    ],
)

# The vitest unit suite. It existed as `pnpm test` for a while but was
# reachable from nothing Bazel runs, so its 9 files sat outside the
# `bazelisk test //...` gate that AGENTS.md calls the source of truth —
# they could have gone red without anyone noticing. This target puts
# them back inside it.
#
# `--run` is load-bearing: bare `vitest` starts a watcher and the test
# action would never terminate.
copy_to_bin(
    name = "vitest_inputs",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = False,
    ) + [
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
    ],
)

vitest_bin.vitest_test(
    name = "unit_test",
    args = ["--run"],
    chdir = package_name(),
    data = [
        ":node_modules",
        ":vitest_inputs",
    ],
)
