load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# What a dev launcher needs to stage a `DATALIB_RUNTIME_DIR` (see
# dev_runtime.sh): the Bazel-managed Node and the two package stores,
# plus their locations as runfiles paths — `rlocationpath` rather than a
# hand-written `_main/...` string, so a moved target fails at analysis
# time instead of at `rlocation` time. Every launcher that reaches
# serve_dev.sh carries both, because `env` applies only to the target
# `bazel run` was given, not to a script it execs.
_DEV_RUNTIME_DATA = [
    "dev_runtime.sh",
    "@nodejs_host//:node_bin",
    "//third-party/qmd/runtime:qmd_tree",
    "//third-party/qmd/runtime:package.json",
    "//third-party/qmd/runtime:qmd_package_dir",
    "//third-party/latchkey/runtime:latchkey_tree",
    "//third-party/latchkey/runtime:package.json",
    "//third-party/latchkey/runtime:latchkey_package_dir",
]

_DEV_RUNTIME_ENV = {
    "DATALIB_DEV_NODE_BIN_RLOC": "$(rlocationpath @nodejs_host//:node_bin)",
    "DATALIB_DEV_QMD_PKG_RLOC": "$(rlocationpath //third-party/qmd/runtime:package.json)",
    "DATALIB_DEV_QMD_DIR_RLOC": "$(rlocationpath //third-party/qmd/runtime:qmd_package_dir)",
    "DATALIB_DEV_LATCHKEY_PKG_RLOC": "$(rlocationpath //third-party/latchkey/runtime:package.json)",
    "DATALIB_DEV_LATCHKEY_DIR_RLOC": "$(rlocationpath //third-party/latchkey/runtime:latchkey_package_dir)",
}

# Backend-only: launch datalib_http_bin and open browser at /api/health.
sh_binary(
    name = "serve",
    srcs = ["serve_dev.sh"],
    data = [
        "//datalib/backend/http:datalib_http_bin",
        # The HTTP backend's sync worker shells out to the runner, which
        # spawns step binaries off PATH. `:bin` is that whole set under
        # their public dash-separated names in one directory; serve_dev.sh
        # exports it as $DATALIB_BINARY_DIR and takes $DATALIB_DAG_BIN
        # from inside it.
        "//datalib/backend:bin",
    ] + _DEV_RUNTIME_DATA,
    env = _DEV_RUNTIME_ENV,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Full dev: backend + Vite UI, browser opens at the Vite URL. Both Vite
# and the backend default to ephemeral ports (printed at startup); Vite's
# /api proxy is wired to the chosen backend port via DATALIB_BACKEND.
# Pin specific ports with DATALIB_PORT / DATALIB_BIND. Requires
# pnpm on PATH.
sh_binary(
    name = "dev",
    srcs = ["dev.sh"],
    data = [
        "//datalib/backend/http:datalib_http_bin",
        # Sync worker children, staged under their public names by
        # `:bin`; dev.sh exports $DATALIB_DAG_BIN and $DATALIB_BINARY_DIR
        # from it so UI-triggered syncs run end-to-end.
        "//datalib/backend:bin",
    ] + _DEV_RUNTIME_DATA,
    env = _DEV_RUNTIME_ENV,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Same as :serve, but materializes a one-shot data root from the
# checked-in TNG fixtures (`//tests/fixtures:ingested_tng`) into a
# tmpdir and points the backend at it. Useful for eyeballing the grid
# without needing a real on-disk datalib root. The packaged
# `datalib_http_bin` serves both the embedded SPA and `/api/*`, so
# we go through serve_dev.sh (no Vite dev server). The ingest genrule
# links doltlite statically (via `//third-party/doltlite:sqlite3`), so
# no host `dolt` install is needed.
sh_binary(
    name = "dev_tng",
    srcs = ["dev_tng.sh"],
    data = [
        ":serve",
        "//tests/fixtures:materialize_tng_root",
    ] + _DEV_RUNTIME_DATA,
    env = _DEV_RUNTIME_ENV,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Same shape as :dev_tng, but bootstraps a one-shot data root from the
# in-crate Perseus tiny fixture (Thucydides 1.1, two sections, both
# languages). Translate-only — no GitHub fetch needed — so the
# pipeline runs entirely off the checked-in TEI XMLs and produces a
# data root the bilingual `edges` UI lights up against. Useful for
# eyeballing cross-language doc links + first-word span anchors
# without populating a real on-disk root.
sh_binary(
    name = "dev_perseus",
    srcs = ["dev_perseus.sh"],
    data = [
        ":serve",
        "//datalib/backend:bin",
        "//datalib/backend/etl/providers/perseus:tiny_fixture",
    ] + _DEV_RUNTIME_DATA,
    env = _DEV_RUNTIME_ENV,
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
